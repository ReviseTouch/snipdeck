#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Зображення завантажено.\r\nПосилання скопійовано до буфера:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Зображення завантажено:\r\n{url}\r\n\r\n(Не вдалося скопіювати посилання до буфера.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Завантаження"

msgid "Upload failed:\r\n{err}"
msgstr "Помилка завантаження:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Imgur Client-ID не налаштовано — завантаження неможливе.\r\n\r\n1) Отримайте безкоштовний Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Додайте його до цього файлу:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Перезапустіть Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — необхідний Imgur Client-ID"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Це зображення буде завантажено до ІНТЕРНЕТУ — \"Imgur\" (анонімно).\r\n\r\n• Воно НЕ з'явиться на головній сторінці / у галереї Imgur (приховане, без лістингу).\r\n• Але будь-хто, хто має посилання, зможе відкрити зображення.\r\n• Зображення не зашифровано.\r\n• НЕ завантажуйте КОНФІДЕНЦІЙНИЙ вміст: документи, паролі або особисті повідомлення.\r\n\r\nУ разі успіху посилання буде скопійовано до буфера обміну.\r\n\r\nЗавантажити?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Це зображення буде завантажено до ІНТЕРНЕТУ — \"catbox.moe\".\r\n\r\n• Воно НЕ з'явиться в жодній публічній галереї / пошуку (без лістингу).\r\n• Але будь-хто, хто має посилання, зможе відкрити зображення.\r\n• Оскільки завантаження анонімне, ВИ НЕ ЗМОЖЕТЕ ВИДАЛИТИ ЙОГО самостійно пізніше.\r\n• Зображення не зашифровано.\r\n• НЕ завантажуйте КОНФІДЕНЦІЙНИЙ вміст: документи, паролі або особисті повідомлення.\r\n\r\nУ разі успіху посилання буде скопійовано до буфера обміну.\r\n\r\nЗавантажити?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Завантаження до інтернету"

#. ── Share / mail dialogs ──
msgid "The image has been copied to the clipboard.\r\nPaste it into the open email with Ctrl+V."
msgstr "Зображення скопійовано до буфера обміну.\r\nВставте його у відкритий лист за допомогою Ctrl+V."

msgid "The email opened, but the image could not be copied to the clipboard.\r\nCopy the snip again and paste it with Ctrl+V."
msgstr "Лист відкрито, але зображення не вдалося скопіювати до буфера обміну.\r\nСкопіюйте знімок ще раз і вставте його за допомогою Ctrl+V."

msgid "Snipdeck — Attach to email"
msgstr "Snipdeck — Додати до листа"

