msgstr "Ảnh đã được sao chép vào bộ nhớ tạm.\r\nDán vào email đang mở bằng Ctrl+V."

msgid "The email opened, but the image could not be copied to the clipboard.\r\nCopy the snip again and paste it with Ctrl+V."
msgstr "Email đã mở, nhưng không thể sao chép ảnh vào bộ nhớ tạm.\r\nHãy sao chép ảnh chụp lại và dán bằng Ctrl+V."

msgid "Snipdeck — Attach to email"
msgstr "Snipdeck — Đính kèm vào email"

msgid "Language"
