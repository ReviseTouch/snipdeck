#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "Công cụ chụp màn hình nhanh, miễn phí, mã nguồn mở cho Windows và Linux."

msgid "About Snipdeck"
msgstr "Giới thiệu Snipdeck"

msgid "Add at least two snips to make a collage."
msgstr "Hãy thêm ít nhất hai ảnh chụp để tạo ảnh ghép."

msgid "Asked once; your answer is remembered."
msgstr "Chỉ hỏi một lần; câu trả lời của bạn sẽ được ghi nhớ."

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "Chụp một vùng màn hình bằng Super + Alt + kéo."

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "Chụp một vùng màn hình bằng nút Mới hoặc phím tắt."

msgid "Collage"
msgstr "Ảnh ghép"

msgid "Colour picker unavailable: {e}"
msgstr "Không thể dùng công cụ chọn màu: {e}"

msgid "Combine several snips into one collage"
msgstr "Ghép nhiều ảnh chụp thành một ảnh ghép"

msgid "Copy the snip image to the clipboard"
msgstr "Sao chép ảnh chụp vào bộ nhớ tạm"

msgid "Crop by dragging the edges inward"
msgstr "Cắt xén bằng cách kéo các cạnh vào trong"

msgid "Delete all {} snips?"
msgstr "Xóa tất cả {} ảnh chụp?"

msgid "Delete the snip permanently"
msgstr "Xóa vĩnh viễn ảnh chụp"

msgid "Delete {} unpinned snips?"
msgstr "Xóa {} ảnh chụp chưa ghim?"

msgid "Discard"
msgstr "Loại bỏ"

msgid "Discard your annotations?"
msgstr "Loại bỏ chú thích của bạn?"

msgid "Draw and mark up the snip"
msgstr "Vẽ và đánh dấu trên ảnh chụp"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "Tất cả ảnh chụp sẽ bị xóa, kể cả ảnh đã ghim. Các ảnh bị xóa khỏi ổ đĩa và không thể khôi phục."

msgid "Everything drawn since the editor opened will be lost."
msgstr "Mọi nội dung đã vẽ kể từ khi mở trình chỉnh sửa sẽ bị mất."

msgid "Failed to open annotation editor: {e}"
msgstr "Không thể mở trình chỉnh sửa chú thích: {e}"

msgid "Failed to open collage: {e}"
msgstr "Không thể mở ảnh ghép: {e}"

msgid "Failed to open window: {e}"
msgstr "Không thể mở cửa sổ: {e}"

msgid "Failed to read image: {e}"
msgstr "Không thể đọc ảnh: {e}"

msgid "Failed to save snip: {e}"
msgstr "Không thể lưu ảnh chụp: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "Hãy hoàn tất hoặc hủy chú thích đang mở trước khi bắt đầu chú thích khác."

msgid "Flip horizontally"
msgstr "Lật ngang"

msgid "Flip vertically"
msgstr "Lật dọc"

msgid "Gap"
msgstr "Khoảng cách"

msgid "Hide from screen (stays in the gallery)"
msgstr "Ẩn khỏi màn hình (vẫn giữ trong thư viện)"

msgid "Hover an item to see what it does"
msgstr "Di chuột lên một mục để xem chức năng của nó"

msgid "Keep editing"
msgstr "Tiếp tục sửa"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "Tạo bởi ReviseTouch — chúng tôi phát triển công cụ cho lập trình viên và sản phẩm AI."

msgid "New email with the snip attached"
msgstr "Email mới đính kèm ảnh chụp"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "OCR + Dịch đọc văn bản trong ảnh chụp này ngay trên máy tính của bạn, rồi gửi văn bản đó — không phải hình ảnh — tới Google Dịch (translate.googleapis.com). Không phần nào khác của Snipdeck gửi bất cứ thứ gì mà không hỏi trước."

msgid "Open in the system image editor"
msgstr "Mở bằng trình chỉnh sửa ảnh của hệ thống"

msgid "Open the main Snipdeck window"
msgstr "Mở cửa sổ chính của Snipdeck"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "Chọn màu từ bất kỳ đâu trên màn hình — kính lúp đi theo con trỏ, nhấp để lấy màu"

msgid "Pick a color from this snip with the magnifier"
msgstr "Chọn màu từ ảnh chụp này bằng kính lúp"

msgid "Pick color"
msgstr "Chọn màu"

msgid "Pick images from the tray below to build a collage"
msgstr "Chọn ảnh từ khay bên dưới để tạo ảnh ghép"

msgid "Picked color"
msgstr "Màu đã chọn"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "Ảnh chụp đã ghim được giữ lại. Các ảnh bị xóa khỏi ổ đĩa và không thể khôi phục."

msgid "Read the text in the image and copy it"
msgstr "Nhận dạng văn bản trong ảnh và sao chép"

msgid "Read the text, then translate it"
msgstr "Nhận dạng văn bản, rồi dịch"

msgid "Resize with the corner handles"
msgstr "Thay đổi kích thước bằng tay cầm ở góc"

msgid "Rotate 180°"
msgstr "Xoay 180°"

msgid "Rotate 90° left"
msgstr "Xoay trái 90°"

msgid "Rotate 90° right"
msgstr "Xoay phải 90°"

msgid "Round"
msgstr "Bo góc"

msgid "Run as administrator"
msgstr "Chạy với quyền quản trị"

msgid "Send"
msgstr "Gửi"

msgid "Send the text to Google?"
msgstr "Gửi văn bản tới Google?"

msgid "Settings could not be read and were reset. The old file is kept as {path}"
msgstr "Không thể đọc cài đặt nên đã đặt lại. Tệp cũ được giữ lại thành {path}"

msgid "Share via the Windows share sheet"
msgstr "Chia sẻ qua bảng chia sẻ của Windows"

msgid "Snipping needs pointer access this session does not grant."
msgstr "Chụp màn hình cần quyền truy cập con trỏ mà phiên này không cấp."

msgid "Support"
msgstr "Ủng hộ"

msgid "Take a new snip"
msgstr "Chụp mới"

msgid "Take a new snip — or drag a region with Super + Alt"
msgstr "Chụp mới — hoặc kéo một vùng bằng Super + Alt"

msgid "The colour picker needs pointer access this session does not grant."
msgstr "Công cụ chọn màu cần quyền truy cập con trỏ mà phiên này không cấp."

msgid "Upload to an image host, copy the link"
msgstr "Tải lên dịch vụ lưu trữ ảnh, sao chép liên kết"

msgid "Version"
msgstr "Phiên bản"

msgid "Visit ReviseTouch"
msgstr "Truy cập ReviseTouch"

msgid "eyedropper"
msgstr "ống hút màu"

#. ── Toolbar redesign, October 2026 ──

msgid "Filter"
msgstr "Lọc"

msgid "Clear filters"
msgstr "Xóa bộ lọc"

msgid "More"
msgstr "Thêm"

msgid "Dark theme"
msgstr "Giao diện tối"

msgid "Floating snips in the taskbar"
msgstr "Ảnh chụp nổi trên thanh tác vụ"

msgid "Upload to"
msgstr "Tải lên tới"

msgid "Add from a .sxcu file…"
msgstr "Thêm từ tệp .sxcu…"

msgid "Remove this host"
msgstr "Gỡ dịch vụ này"

msgid "Upload this snip?"
msgstr "Tải ảnh chụp này lên?"

msgid "Uploading…"
msgstr "Đang tải lên…"

msgid "Uploaded"
msgstr "Đã tải lên"

msgid "Upload failed"
msgstr "Tải lên không thành công"

msgid "Imgur needs a Client-ID"
msgstr "Imgur cần Client-ID"

msgid "Anyone with the link can open the image."
msgstr "Bất kỳ ai có liên kết đều có thể mở ảnh."

msgid "It is not listed or searchable anywhere."
msgstr "Ảnh không được liệt kê hay tìm thấy ở bất kỳ đâu."

msgid "Uploaded anonymously, it cannot be deleted later."
msgstr "Ảnh được tải lên ẩn danh nên không thể xóa sau này."

msgid "The connection is not encrypted: others on the network can see the image."
msgstr "Kết nối không được mã hóa: người khác trong mạng có thể thấy ảnh."

msgid "Don't upload IDs, passwords or private messages."
msgstr "Đừng tải lên giấy tờ tùy thân, mật khẩu hay tin nhắn riêng tư."

msgid "When it is done, the link is copied to the clipboard."
msgstr "Khi hoàn tất, liên kết sẽ được sao chép vào bộ nhớ tạm."

msgid "The link is on the clipboard."
msgstr "Liên kết đã ở trong bộ nhớ tạm."

msgid "The link could not be copied; use Copy link."
msgstr "Không thể sao chép liên kết; hãy dùng “Sao chép liên kết”."

msgid "Imgur's anonymous uploads need a free Client-ID. Register an application at imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), put its Client-ID in the settings file as \"imgur_client_id\", and restart Snipdeck."
msgstr "Tải lên ẩn danh của Imgur cần một Client-ID miễn phí. Hãy đăng ký một ứng dụng tại imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), đặt Client-ID của ứng dụng vào tệp cài đặt dưới dạng \"imgur_client_id\", rồi khởi động lại Snipdeck."

msgid "Upload"
msgstr "Tải lên"

msgid "Hide"
msgstr "Ẩn"

msgid "Copy link"
msgstr "Sao chép liên kết"

msgid "Open link"
msgstr "Mở liên kết"

msgid "Open settings file"
msgstr "Mở tệp cài đặt"

msgid "Try again"
msgstr "Thử lại"

msgid "This file is not a ShareX custom uploader."
msgstr "Tệp này không phải là trình tải lên tùy chỉnh của ShareX."

msgid "It sends the image as \"{body}\"; Snipdeck can send multipart form data or a binary body."
msgstr "Tệp gửi ảnh dưới dạng \"{body}\"; Snipdeck có thể gửi dữ liệu biểu mẫu multipart hoặc nội dung nhị phân."

msgid "It must upload to an http:// or https:// address."
msgstr "Tệp phải tải lên một địa chỉ http:// hoặc https://."

msgid "Only POST, PUT and PATCH uploads are supported."
msgstr "Chỉ hỗ trợ tải lên bằng POST, PUT và PATCH."

msgid "It uploads text or shortens links, not images."
msgstr "Tệp dùng để tải lên văn bản hoặc rút gọn liên kết, không phải ảnh."

msgid "It does not say which form field carries the image (FileFormName)."
msgstr "Tệp không cho biết trường biểu mẫu nào chứa ảnh (FileFormName)."

msgid "The host answered without a link: {answer}"
msgstr "Dịch vụ phản hồi mà không có liên kết: {answer}"

msgid "It uses {what}, which Snipdeck does not support."
msgstr "Tệp dùng {what}, mà Snipdeck không hỗ trợ."

msgid "The host's answer has no {what}."
msgstr "Phản hồi của dịch vụ không có {what}."

msgid "Could not reach {host}: {e}"
msgstr "Không thể kết nối tới {host}: {e}"

msgid "Could not add the upload host: {why}"
msgstr "Không thể thêm dịch vụ tải lên: {why}"
