#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "Una herramienta de recortes de pantalla rápida, gratuita y de código abierto para Windows y Linux."

msgid "About Snipdeck"
msgstr "Acerca de Snipdeck"

msgid "Add at least two snips to make a collage."
msgstr "Añade al menos dos recortes para crear un collage."

msgid "Asked once; your answer is remembered."
msgstr "Se pregunta una sola vez; tu respuesta se recuerda."

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "Captura una región de la pantalla con Super + Alt + arrastrar."

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "Captura una región de la pantalla con el botón Nuevo o un atajo de teclado."

msgid "Collage"
msgstr "Collage"

msgid "Colour picker unavailable: {e}"
msgstr "Selector de color no disponible: {e}"

msgid "Combine several snips into one collage"
msgstr "Combinar varios recortes en un collage"

msgid "Copy the snip image to the clipboard"
msgstr "Copiar la imagen del recorte al portapapeles"

msgid "Crop by dragging the edges inward"
msgstr "Recortar arrastrando los bordes hacia adentro"

msgid "Delete all {} snips?"
msgstr "¿Eliminar todos los {} recortes?"

msgid "Delete the snip permanently"
msgstr "Eliminar el recorte de forma permanente"

msgid "Delete {} unpinned snips?"
msgstr "¿Eliminar {} recortes no fijados?"

msgid "Discard"
msgstr "Descartar"

msgid "Discard your annotations?"
msgstr "¿Descartar tus anotaciones?"

msgid "Draw and mark up the snip"
msgstr "Dibujar y marcar sobre el recorte"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "Se eliminan todos los recortes, incluidos los fijados. Las imágenes se borran del disco y no se pueden recuperar."

msgid "Everything drawn since the editor opened will be lost."
msgstr "Se perderá todo lo dibujado desde que se abrió el editor."

msgid "Failed to open annotation editor: {e}"
msgstr "Error al abrir el editor de anotaciones: {e}"

msgid "Failed to open collage: {e}"
msgstr "Error al abrir el collage: {e}"

msgid "Failed to open window: {e}"
msgstr "Error al abrir la ventana: {e}"

msgid "Failed to read image: {e}"
msgstr "Error al leer la imagen: {e}"

msgid "Failed to save snip: {e}"
msgstr "Error al guardar el recorte: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "Termina o cancela la anotación abierta antes de empezar otra."

msgid "Flip horizontally"
msgstr "Voltear horizontalmente"

msgid "Flip vertically"
msgstr "Voltear verticalmente"

msgid "Gap"
msgstr "Espacio"

msgid "Hide from screen (stays in the gallery)"
msgstr "Ocultar de la pantalla (permanece en la galería)"

msgid "Hover an item to see what it does"
msgstr "Pasa el cursor sobre un elemento para ver qué hace"

msgid "Keep editing"
msgstr "Seguir editando"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "Hecho por ReviseTouch — creamos herramientas para desarrolladores y productos de IA."

msgid "New email with the snip attached"
msgstr "Nuevo correo con el recorte adjunto"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "OCR + Traducir lee el texto de este recorte en tu equipo y luego envía ese texto — no la imagen — a Google Traductor (translate.googleapis.com). Ninguna otra parte de Snipdeck envía nada sin preguntar."

msgid "Open in the system image editor"
msgstr "Abrir en el editor de imágenes del sistema"

msgid "Open the main Snipdeck window"
msgstr "Abrir la ventana principal de Snipdeck"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "Elegir un color de cualquier parte de la pantalla — una lupa sigue al cursor, haz clic para tomarlo"

msgid "Pick a color from this snip with the magnifier"
msgstr "Elegir un color de este recorte con la lupa"

msgid "Pick color"
msgstr "Elegir color"

msgid "Pick images from the tray below to build a collage"
msgstr "Elige imágenes de la bandeja inferior para crear un collage"

msgid "Picked color"
msgstr "Color elegido"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "Los recortes fijados se conservan. Las imágenes se borran del disco y no se pueden recuperar."

msgid "Read the text in the image and copy it"
msgstr "Reconocer el texto de la imagen y copiarlo"

msgid "Read the text, then translate it"
msgstr "Reconocer el texto y luego traducirlo"

msgid "Resize with the corner handles"
msgstr "Redimensionar con los controladores de las esquinas"

msgid "Rotate 180°"
msgstr "Girar 180°"

msgid "Rotate 90° left"
msgstr "Girar 90° a la izquierda"

msgid "Rotate 90° right"
msgstr "Girar 90° a la derecha"

msgid "Round"
msgstr "Redondeo"

msgid "Run as administrator"
msgstr "Ejecutar como administrador"

msgid "Send"
msgstr "Enviar"

msgid "Send the text to Google?"
msgstr "¿Enviar el texto a Google?"

msgid "Settings could not be read and were reset. The old file is kept as {path}"
msgstr "No se pudo leer la configuración y se restableció. El archivo anterior se conserva como {path}"

msgid "Share via the Windows share sheet"
msgstr "Compartir con el panel de compartir de Windows"

msgid "Snipping needs pointer access this session does not grant."
msgstr "Hacer recortes requiere acceso al puntero, que esta sesión no concede."

msgid "Support"
msgstr "Apoyar"

msgid "Take a new snip"
msgstr "Hacer un nuevo recorte"

msgid "Take a new snip — or drag a region with Super + Alt"
msgstr "Hacer un nuevo recorte — o arrastra una región con Super + Alt"

msgid "The colour picker needs pointer access this session does not grant."
msgstr "El selector de color requiere acceso al puntero, que esta sesión no concede."

msgid "Upload to an image host, copy the link"
msgstr "Subir a un alojamiento de imágenes y copiar el enlace"

msgid "Version"
msgstr "Versión"

msgid "Visit ReviseTouch"
msgstr "Visitar ReviseTouch"

msgid "eyedropper"
msgstr "cuentagotas"

