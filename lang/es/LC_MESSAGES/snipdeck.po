msgid "Filter"
msgstr "Filtrar"

msgid "Clear filters"
msgstr "Quitar filtros"

msgid "More"
msgstr "Más"

msgid "Dark theme"
msgstr "Tema oscuro"

msgid "Floating snips in the taskbar"
msgstr "Recortes flotantes en la barra de tareas"

msgid "Upload to"
msgstr "Subir a"

msgid "Add from a .sxcu file…"
msgstr "Añadir desde un archivo .sxcu…"

msgid "Remove this host"
msgstr "Quitar este servicio"

msgid "Upload this snip?"
msgstr "¿Subir este recorte?"

msgid "Uploading…"
msgstr "Subiendo…"

msgid "Uploaded"
msgstr "Subido"

msgid "Upload failed"
msgstr "Error al subir"

msgid "Imgur needs a Client-ID"
msgstr "Imgur necesita un Client-ID"

msgid "Anyone with the link can open the image."
msgstr "Cualquiera con el enlace puede abrir la imagen."

msgid "It is not listed or searchable anywhere."
msgstr "No aparece en listados ni en búsquedas."

msgid "Uploaded anonymously, it cannot be deleted later."
msgstr "Se sube de forma anónima: no podrá eliminarse después."

msgid "The connection is not encrypted: others on the network can see the image."
msgstr "La conexión no está cifrada: otras personas de la red pueden ver la imagen."

msgid "Don't upload IDs, passwords or private messages."
msgstr "No subas documentos de identidad, contraseñas ni mensajes privados."

msgid "When it is done, the link is copied to the clipboard."
msgstr "Al terminar, el enlace se copia al portapapeles."

msgid "The link is on the clipboard."
msgstr "El enlace está en el portapapeles."

msgid "The link could not be copied; use Copy link."
msgstr "No se pudo copiar el enlace; usa Copiar enlace."

msgid "Imgur's anonymous uploads need a free Client-ID. Register an application at imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), put its Client-ID in the settings file as \"imgur_client_id\", and restart Snipdeck."
msgstr "Las subidas anónimas a Imgur necesitan un Client-ID gratuito. Registra una aplicación en imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), pon su Client-ID en el archivo de configuración como \"imgur_client_id\" y reinicia Snipdeck."

msgid "Upload"
msgstr "Subir"

msgid "Hide"
msgstr "Ocultar"

msgid "Copy link"
msgstr "Copiar enlace"

msgid "Open link"
msgstr "Abrir enlace"

msgid "Open settings file"
msgstr "Abrir configuración"

msgid "Try again"
msgstr "Reintentar"

msgid "This file is not a ShareX custom uploader."
msgstr "Este archivo no es un uploader personalizado de ShareX."

msgid "It sends the image as \"{body}\"; Snipdeck can send multipart form data or a binary body."
msgstr "El archivo envía la imagen como \"{body}\"; Snipdeck puede enviar datos de formulario multipart o un cuerpo binario."

msgid "It must upload to an http:// or https:// address."
msgstr "El archivo debe subir a una dirección http:// o https://."

msgid "Only POST, PUT and PATCH uploads are supported."
msgstr "Solo se admiten subidas POST, PUT y PATCH."

msgid "It uploads text or shortens links, not images."
msgstr "El archivo sube texto o acorta enlaces, no imágenes."

msgid "It does not say which form field carries the image (FileFormName)."
msgstr "El archivo no indica qué campo del formulario lleva la imagen (FileFormName)."

msgid "The host answered without a link: {answer}"
msgstr "El servicio respondió sin un enlace: {answer}"

msgid "It uses {what}, which Snipdeck does not support."
msgstr "El archivo usa {what}, que Snipdeck no admite."

msgid "The host's answer has no {what}."
msgstr "La respuesta del servicio no incluye {what}."

msgid "Could not reach {host}: {e}"
msgstr "No se pudo conectar con {host}: {e}"

msgid "Could not add the upload host: {why}"
msgstr "No se pudo añadir el servicio de subida: {why}"

msgid "Imgur refused the Client-ID (HTTP 403)."
msgstr "Imgur rechazó el Client-ID (HTTP 403)."

msgid "Imgur's upload limit is reached (HTTP 429). Try again later."
msgstr "Se alcanzó el límite de subidas de Imgur (HTTP 429). Inténtalo de nuevo más tarde."
