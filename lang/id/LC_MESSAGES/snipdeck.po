#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Gambar diunggah.\r\nTautan disalin ke papan klip:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Gambar diunggah:\r\n{url}\r\n\r\n(Tautan tidak dapat disalin ke papan klip.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Unggah"

msgid "Upload failed:\r\n{err}"
msgstr "Unggahan gagal:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Imgur Client-ID belum dikonfigurasi — tidak dapat mengunggah.\r\n\r\n1) Dapatkan Client-ID gratis:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Tambahkan ke file ini:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Mulai ulang Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Imgur Client-ID diperlukan"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Gambar ini akan diunggah ke INTERNET — \"Imgur\" (anonim).\r\n\r\n• Gambar TIDAK akan muncul di halaman utama / galeri Imgur (tersembunyi, tidak terdaftar).\r\n• Namun siapa pun yang memiliki tautan tersebut dapat membuka gambar.\r\n• Gambar tidak dienkripsi.\r\n• JANGAN mengunggah konten SENSITIF seperti ID, kata sandi, atau pesan pribadi.\r\n\r\nJika berhasil, tautan disalin ke papan klip Anda.\r\n\r\nUnggah?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Gambar ini akan diunggah ke INTERNET — \"catbox.moe\".\r\n\r\n• Gambar TIDAK akan muncul di galeri / pencarian publik mana pun (tidak terdaftar).\r\n• Namun siapa pun yang memiliki tautan tersebut dapat membuka gambar.\r\n• Karena diunggah secara anonim, ANDA TIDAK DAPAT MENGHAPUSNYA sendiri nanti.\r\n• Gambar tidak dienkripsi.\r\n• JANGAN mengunggah konten SENSITIF seperti ID, kata sandi, atau pesan pribadi.\r\n\r\nJika berhasil, tautan disalin ke papan klip Anda.\r\n\r\nUnggah?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Unggah ke internet"

