#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "أداة سريعة ومجانية ومفتوحة المصدر لالتقاط لقطات الشاشة على Windows و Linux."

msgid "About Snipdeck"
msgstr "حول Snipdeck"

msgid "Add at least two snips to make a collage."
msgstr "أضف لقطتين على الأقل لإنشاء كولاج."

msgid "Asked once; your answer is remembered."
msgstr "يُطرح السؤال مرة واحدة؛ وتُحفظ إجابتك."

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "التقط منطقة من الشاشة باستخدام Super + Alt + السحب."

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "التقط منطقة من الشاشة بزر «جديد» أو باختصار لوحة المفاتيح."

msgid "Collage"
msgstr "كولاج"

msgid "Colour picker unavailable: {e}"
msgstr "منتقي الألوان غير متاح: {e}"

msgid "Combine several snips into one collage"
msgstr "ادمج عدة لقطات في كولاج واحد"

msgid "Copy the snip image to the clipboard"
msgstr "انسخ صورة اللقطة إلى الحافظة"

msgid "Crop by dragging the edges inward"
msgstr "قُصّ بسحب الحواف إلى الداخل"

msgid "Delete all {} snips?"
msgstr "حذف جميع اللقطات ({})؟"

msgid "Delete the snip permanently"
msgstr "حذف اللقطة نهائيًا"

msgid "Delete {} unpinned snips?"
msgstr "حذف اللقطات غير المثبتة ({})؟"

msgid "Discard"
msgstr "تجاهل"

msgid "Discard your annotations?"
msgstr "تجاهل التعليقات التوضيحية؟"

msgid "Draw and mark up the snip"
msgstr "ارسم وضع علامات على اللقطة"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "ستُحذف كل اللقطات، بما فيها المثبتة. تُحذف الصور من القرص ولا يمكن استعادتها."

msgid "Everything drawn since the editor opened will be lost."
msgstr "سيُفقد كل ما رُسم منذ فتح المحرر."

msgid "Failed to open annotation editor: {e}"
msgstr "فشل فتح محرر التعليقات التوضيحية: {e}"

msgid "Failed to open collage: {e}"
msgstr "فشل فتح الكولاج: {e}"

msgid "Failed to open window: {e}"
msgstr "فشل فتح النافذة: {e}"

msgid "Failed to read image: {e}"
msgstr "فشل قراءة الصورة: {e}"

msgid "Failed to save snip: {e}"
msgstr "فشل حفظ اللقطة: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "أنهِ التعليق التوضيحي المفتوح أو ألغِه قبل بدء تعليق آخر."

msgid "Flip horizontally"
msgstr "قلب أفقيًا"

msgid "Flip vertically"
msgstr "قلب عموديًا"

msgid "Gap"
msgstr "التباعد"

msgid "Hide from screen (stays in the gallery)"
msgstr "إخفاء من الشاشة (تبقى في المعرض)"

msgid "Hover an item to see what it does"
msgstr "مرّر المؤشر فوق عنصر لمعرفة وظيفته"

msgid "Keep editing"
msgstr "متابعة التحرير"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "من صنع ReviseTouch — نطوّر أدوات للمطورين ومنتجات ذكاء اصطناعي."

msgid "New email with the snip attached"
msgstr "بريد إلكتروني جديد مع إرفاق اللقطة"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "تقرأ ميزة OCR + ترجمة النص في هذه اللقطة على جهازك، ثم ترسل هذا النص — وليس الصورة — إلى Google Translate (translate.googleapis.com). لا شيء آخر في Snipdeck يرسل أي شيء دون أن يسألك."

msgid "Open in the system image editor"
msgstr "فتح في محرر الصور الخاص بالنظام"

msgid "Open the main Snipdeck window"
msgstr "فتح نافذة Snipdeck الرئيسية"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "التقط لونًا من أي مكان على الشاشة — تتبع عدسة مكبّرة المؤشر، انقر لأخذ اللون"

msgid "Pick a color from this snip with the magnifier"
msgstr "التقط لونًا من هذه اللقطة باستخدام العدسة المكبّرة"

msgid "Pick color"
msgstr "انتقاء لون"

msgid "Pick images from the tray below to build a collage"
msgstr "اختر صورًا من الشريط أدناه لإنشاء كولاج"

msgid "Picked color"
msgstr "اللون المنتقى"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "تبقى اللقطات المثبتة. تُحذف الصور من القرص ولا يمكن استعادتها."

msgid "Read the text in the image and copy it"
msgstr "تعرّف على النص في الصورة وانسخه"

msgid "Read the text, then translate it"
msgstr "تعرّف على النص ثم ترجمه"

msgid "Resize with the corner handles"
msgstr "غيّر الحجم بمقابض الزوايا"

msgid "Rotate 180°"
msgstr "تدوير 180°"

msgid "Rotate 90° left"
msgstr "تدوير 90° لليسار"

msgid "Rotate 90° right"
msgstr "تدوير 90° لليمين"

msgid "Round"
msgstr "الاستدارة"

msgid "Run as administrator"
msgstr "تشغيل كمسؤول"

msgid "Send"
msgstr "إرسال"

msgid "Send the text to Google?"
msgstr "إرسال النص إلى Google؟"

msgid "Settings could not be read and were reset. The old file is kept as {path}"
msgstr "تعذّرت قراءة الإعدادات وأُعيد تعيينها. تم الاحتفاظ بالملف القديم باسم {path}"

msgid "Share via the Windows share sheet"
msgstr "مشاركة عبر لوحة المشاركة في Windows"

msgid "Snipping needs pointer access this session does not grant."
msgstr "يتطلب الالتقاط وصولًا إلى المؤشر لا تمنحه هذه الجلسة."

msgid "Support"
msgstr "الدعم"

msgid "Take a new snip"
msgstr "التقط لقطة جديدة"

msgid "Take a new snip — or drag a region with Super + Alt"
msgstr "التقط لقطة جديدة — أو اسحب منطقة باستخدام Super + Alt"

msgid "The colour picker needs pointer access this session does not grant."
msgstr "يتطلب منتقي الألوان وصولًا إلى المؤشر لا تمنحه هذه الجلسة."

msgid "Upload to an image host, copy the link"
msgstr "ارفع إلى خدمة استضافة صور وانسخ الرابط"

msgid "Version"
msgstr "الإصدار"

msgid "Visit ReviseTouch"
msgstr "زيارة ReviseTouch"

msgid "eyedropper"
msgstr "قطّارة"

#. ── Toolbar redesign, October 2026 ──

msgid "Filter"
msgstr "تصفية"

msgid "Clear filters"
msgstr "مسح المرشحات"

msgid "More"
msgstr "المزيد"

msgid "Dark theme"
msgstr "المظهر الداكن"

msgid "Floating snips in the taskbar"
msgstr "اللقطات العائمة في شريط المهام"

msgid "Upload to"
msgstr "رفع إلى"

msgid "Add from a .sxcu file…"
msgstr "إضافة من ملف .sxcu…"

msgid "Remove this host"
msgstr "إزالة هذه الخدمة"

msgid "Upload this snip?"
msgstr "هل تريد رفع هذه اللقطة؟"

msgid "Uploading…"
msgstr "جارٍ الرفع…"

msgid "Uploaded"
msgstr "تم الرفع"

msgid "Upload failed"
msgstr "فشل الرفع"

msgid "Imgur needs a Client-ID"
msgstr "يحتاج Imgur إلى Client-ID"

msgid "Anyone with the link can open the image."
msgstr "يمكن لأي شخص لديه الرابط فتح الصورة."

msgid "It is not listed or searchable anywhere."
msgstr "لا تظهر في أي قائمة ولا يمكن العثور عليها بالبحث."

msgid "Uploaded anonymously, it cannot be deleted later."
msgstr "تُرفع بشكل مجهول، ولا يمكن حذفها لاحقًا."

msgid "The connection is not encrypted: others on the network can see the image."
msgstr "الاتصال غير مشفّر: يمكن للآخرين على الشبكة رؤية الصورة."

msgid "Don't upload IDs, passwords or private messages."
msgstr "لا ترفع بطاقات الهوية أو كلمات المرور أو الرسائل الخاصة."

msgid "When it is done, the link is copied to the clipboard."
msgstr "عند الانتهاء، يُنسخ الرابط إلى الحافظة."

msgid "The link is on the clipboard."
msgstr "الرابط في الحافظة."

msgid "The link could not be copied; use Copy link."
msgstr "تعذّر نسخ الرابط؛ استخدم «نسخ الرابط»."

msgid "Imgur's anonymous uploads need a free Client-ID. Register an application at imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), put its Client-ID in the settings file as \"imgur_client_id\", and restart Snipdeck."
msgstr "يحتاج الرفع المجهول إلى Imgur إلى Client-ID مجاني. سجّل تطبيقًا في imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\")، وضع Client-ID الخاص به في ملف الإعدادات باسم \"imgur_client_id\"، ثم أعد تشغيل Snipdeck."

msgid "Upload"
msgstr "رفع"

msgid "Hide"
msgstr "إخفاء"

msgid "Copy link"
msgstr "نسخ الرابط"

msgid "Open link"
msgstr "فتح الرابط"

msgid "Open settings file"
msgstr "فتح ملف الإعدادات"

msgid "Try again"
msgstr "إعادة المحاولة"

msgid "This file is not a ShareX custom uploader."
msgstr "هذا الملف ليس أداة رفع مخصّصة من ShareX."

msgid "It sends the image as \"{body}\"; Snipdeck can send multipart form data or a binary body."
msgstr "يرسل الصورة بصيغة \"{body}\"؛ يستطيع Snipdeck إرسال بيانات نموذج multipart أو محتوى ثنائي."

msgid "It must upload to an http:// or https:// address."
msgstr "يجب أن يرفع إلى عنوان http:// أو https://."

msgid "Only POST, PUT and PATCH uploads are supported."
msgstr "لا يُدعم إلا الرفع عبر POST و PUT و PATCH."

msgid "It uploads text or shortens links, not images."
msgstr "يرفع نصوصًا أو يختصر روابط، لا صورًا."

msgid "It does not say which form field carries the image (FileFormName)."
msgstr "لا يحدد حقل النموذج الذي يحمل الصورة (FileFormName)."

msgid "The host answered without a link: {answer}"
msgstr "ردّ الخادم دون رابط: {answer}"

msgid "It uses {what}, which Snipdeck does not support."
msgstr "يستخدم {what}، وهو ما لا يدعمه Snipdeck."

msgid "The host's answer has no {what}."
msgstr "لا يحتوي ردّ الخادم على {what}."

msgid "Could not reach {host}: {e}"
msgstr "تعذّر الوصول إلى {host}: {e}"

msgid "Could not add the upload host: {why}"
msgstr "تعذّرت إضافة خدمة الرفع: {why}"

msgid "Imgur refused the Client-ID (HTTP 403)."
msgstr "رفض Imgur معرّف Client-ID (HTTP 403)."

msgid "Imgur's upload limit is reached (HTTP 429). Try again later."
msgstr "تم بلوغ حد الرفع في Imgur (HTTP 429). حاول مرة أخرى لاحقًا."
