#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Afbeelding geüpload.\r\nLink gekopieerd naar klembord:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Afbeelding geüpload:\r\n{url}\r\n\r\n(De link kon niet naar het klembord worden gekopieerd.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Uploaden"

msgid "Upload failed:\r\n{err}"
msgstr "Uploaden mislukt:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Geen Imgur Client-ID ingesteld — uploaden niet mogelijk.\r\n\r\n1) Haal een gratis Client-ID op:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Voeg het toe aan dit bestand:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Herstart Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Imgur Client-ID vereist"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Deze afbeelding wordt geüpload naar het INTERNET — \"Imgur\" (anoniem).\r\n\r\n• De afbeelding verschijnt NIET op de Imgur-startpagina / galerij (verborgen, niet vermeld).\r\n• Maar iedereen met de link kan de afbeelding openen.\r\n• De afbeelding is niet versleuteld.\r\n• Upload GEEN GEVOELIGE inhoud zoals ID's, wachtwoorden of privéberichten.\r\n\r\nBij succes wordt de link naar uw klembord gekopieerd.\r\n\r\nUploaden?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Deze afbeelding wordt geüpload naar het INTERNET — \"catbox.moe\".\r\n\r\n• De afbeelding verschijnt NIET in een openbare galerij / zoekopdracht (niet vermeld).\r\n• Maar iedereen met de link kan de afbeelding openen.\r\n• Omdat de upload anoniem is, KUNT U HEM LATER NIET ZELF VERWIJDEREN.\r\n• De afbeelding is niet versleuteld.\r\n• Upload GEEN GEVOELIGE inhoud zoals ID's, wachtwoorden of privéberichten.\r\n\r\nBij succes wordt de link naar uw klembord gekopieerd.\r\n\r\nUploaden?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Uploaden naar internet"

