#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "Windows اور Linux کے لیے اسکرین اسنپ لینے کا ایک تیز، مفت اور اوپن سورس ٹول۔"

msgid "About Snipdeck"
msgstr "Snipdeck کے بارے میں"

msgid "Add at least two snips to make a collage."
msgstr "کولاج بنانے کے لیے کم از کم دو اسنپس شامل کریں۔"

msgid "Asked once; your answer is remembered."
msgstr "صرف ایک بار پوچھا جاتا ہے؛ آپ کا جواب یاد رکھا جاتا ہے۔"

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "Super + Alt + کھینچ کر اسکرین کا علاقہ کیپچر کریں۔"

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "‘نیا’ بٹن یا کسی ہاٹ کی سے اسکرین کا علاقہ کیپچر کریں۔"

msgid "Collage"
msgstr "کولاج"

msgid "Colour picker unavailable: {e}"
msgstr "کلر پکر دستیاب نہیں: {e}"

msgid "Combine several snips into one collage"
msgstr "کئی اسنپس کو ایک کولاج میں جوڑیں"

msgid "Copy the snip image to the clipboard"
msgstr "اسنپ کی تصویر کلپ بورڈ پر کاپی کریں"

msgid "Crop by dragging the edges inward"
msgstr "کناروں کو اندر کھینچ کر کراپ کریں"

msgid "Delete all {} snips?"
msgstr "تمام {} اسنپس حذف کریں؟"

msgid "Delete the snip permanently"
msgstr "اسنپ مستقل طور پر حذف کریں"

msgid "Delete {} unpinned snips?"
msgstr "{} غیر پن اسنپس حذف کریں؟"

msgid "Discard"
msgstr "ترک کریں"

msgid "Discard your annotations?"
msgstr "اپنی تشریحات ترک کریں؟"

msgid "Draw and mark up the snip"
msgstr "اسنپ پر ڈرا کریں اور نشان لگائیں"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "تمام اسنپس حذف ہو جائیں گے، پن کیے ہوئے بھی۔ تصاویر ڈسک سے حذف ہو جاتی ہیں اور بحال نہیں کی جا سکتیں۔"

msgid "Everything drawn since the editor opened will be lost."
msgstr "ایڈیٹر کھلنے کے بعد سے بنایا گیا سب کچھ ضائع ہو جائے گا۔"

msgid "Failed to open annotation editor: {e}"
msgstr "تشریح ایڈیٹر کھولنے میں ناکامی: {e}"

msgid "Failed to open collage: {e}"
msgstr "کولاج کھولنے میں ناکامی: {e}"

msgid "Failed to open window: {e}"
msgstr "ونڈو کھولنے میں ناکامی: {e}"

msgid "Failed to read image: {e}"
msgstr "تصویر پڑھنے میں ناکامی: {e}"

msgid "Failed to save snip: {e}"
msgstr "اسنپ محفوظ کرنے میں ناکامی: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "دوسری شروع کرنے سے پہلے کھلی تشریح مکمل یا منسوخ کریں۔"

msgid "Flip horizontally"
msgstr "افقی طور پر پلٹیں"

msgid "Flip vertically"
msgstr "عمودی طور پر پلٹیں"

msgid "Gap"
msgstr "فاصلہ"

msgid "Hide from screen (stays in the gallery)"
msgstr "اسکرین سے چھپائیں (گیلری میں رہے گا)"

msgid "Hover an item to see what it does"
msgstr "کسی آئٹم پر ماؤس لے جائیں تاکہ معلوم ہو وہ کیا کرتا ہے"

msgid "Keep editing"
msgstr "ترمیم جاری رکھیں"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "ReviseTouch کا بنایا ہوا — ہم ڈویلپر ٹولز اور AI پروڈکٹس بناتے ہیں۔"

msgid "New email with the snip attached"
msgstr "منسلک اسنپ کے ساتھ نئی ای میل"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "OCR + ترجمہ اس اسنپ کا متن آپ کے کمپیوٹر پر پڑھتا ہے، پھر وہ متن — تصویر نہیں — Google Translate (translate.googleapis.com) کو بھیجتا ہے۔ Snipdeck میں اور کوئی چیز آپ سے پوچھے بغیر کچھ نہیں بھیجتی۔"

msgid "Open in the system image editor"
msgstr "سسٹم کے امیج ایڈیٹر میں کھولیں"

msgid "Open the main Snipdeck window"
msgstr "Snipdeck کی مرکزی ونڈو کھولیں"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "اسکرین پر کہیں سے بھی رنگ چنیں — ایک میگنیفائر کرسر کے ساتھ چلتا ہے، لینے کے لیے کلک کریں"

msgid "Pick a color from this snip with the magnifier"
msgstr "میگنیفائر سے اس اسنپ کا رنگ چنیں"

msgid "Pick color"
msgstr "رنگ چنیں"

msgid "Pick images from the tray below to build a collage"
msgstr "کولاج بنانے کے لیے نیچے کی ٹرے سے تصاویر چنیں"

msgid "Picked color"
msgstr "چنا گیا رنگ"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "پن کیے اسنپس رہیں گے۔ تصاویر ڈسک سے حذف ہو جاتی ہیں اور بحال نہیں کی جا سکتیں۔"

msgid "Read the text in the image and copy it"
msgstr "تصویر کا متن پڑھیں اور کاپی کریں"

msgid "Read the text, then translate it"
msgstr "متن پڑھیں، پھر اس کا ترجمہ کریں"

msgid "Resize with the corner handles"
msgstr "کونے کے ہینڈلز سے سائز بدلیں"

msgid "Rotate 180°"
msgstr "180° گھمائیں"

msgid "Rotate 90° left"
msgstr "90° بائیں گھمائیں"

msgid "Rotate 90° right"
msgstr "90° دائیں گھمائیں"

msgid "Round"
msgstr "گولائی"

