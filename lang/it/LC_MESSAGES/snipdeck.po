#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Immagine caricata.\r\nLink copiato negli appunti:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Immagine caricata:\r\n{url}\r\n\r\n(Impossibile copiare il link negli appunti.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Caricamento"

msgid "Upload failed:\r\n{err}"
msgstr "Caricamento non riuscito:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Nessun Client-ID Imgur configurato — impossibile caricare.\r\n\r\n1) Ottieni un Client-ID gratuito:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Aggiungilo a questo file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Riavvia Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Client-ID Imgur richiesto"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Questa immagine verrà caricata su INTERNET — \"Imgur\" (anonimo).\r\n\r\n• NON apparirà nella home page / galleria di Imgur (nascosta, non in elenco).\r\n• Ma chiunque abbia il link risultante potrà aprire l'immagine.\r\n• L'immagine non è crittografata.\r\n• NON caricare contenuti SENSIBILI come documenti d'identità, password o messaggi privati.\r\n\r\nIn caso di successo il link viene copiato negli appunti.\r\n\r\nCaricare?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Questa immagine verrà caricata su INTERNET — \"catbox.moe\".\r\n\r\n• NON apparirà in nessuna galleria pubblica / ricerca (non in elenco).\r\n• Ma chiunque abbia il link risultante potrà aprire l'immagine.\r\n• Poiché viene caricata anonimamente, NON POTRAI ELIMINARLA in seguito.\r\n• L'immagine non è crittografata.\r\n• NON caricare contenuti SENSIBILI come documenti d'identità, password o messaggi privati.\r\n\r\nIn caso di successo il link viene copiato negli appunti.\r\n\r\nCaricare?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Carica su internet"

#. ── Share / mail dialogs ──
msgid "The image has been copied to the clipboard.\r\nPaste it into the open email with Ctrl+V."
msgstr "L'immagine è stata copiata negli appunti.\r\nIncollala nell'email aperta con Ctrl+V."

msgid "The email opened, but the image could not be copied to the clipboard.\r\nCopy the snip again and paste it with Ctrl+V."
msgstr "L'email si è aperta, ma l'immagine non è stata copiata negli appunti.\r\nCopia di nuovo la schermata e incollala con Ctrl+V."

msgid "Snipdeck — Attach to email"
msgstr "Snipdeck — Allega all'email"

msgid "Language"
msgstr "Lingua"

