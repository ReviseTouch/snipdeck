#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Изображение загружено.\r\nСсылка скопирована в буфер обмена:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Изображение загружено:\r\n{url}\r\n\r\n(Не удалось скопировать ссылку в буфер обмена.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Загрузка"

msgid "Upload failed:\r\n{err}"
msgstr "Загрузка не удалась:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Imgur Client-ID не настроен — загрузка невозможна.\r\n\r\n1) Получите бесплатный Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Добавьте его в этот файл:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Перезапустите Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — требуется Imgur Client-ID"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Это изображение будет загружено в ИНТЕРНЕТ — «Imgur» (анонимно).\r\n\r\n• Оно НЕ появится на главной странице / в галерее Imgur (скрыто, без публикации).\r\n• Но любой, у кого есть ссылка, сможет открыть изображение.\r\n• Изображение не зашифровано.\r\n• НЕ загружайте КОНФИДЕНЦИАЛЬНОЕ содержимое: удостоверения, пароли, личные сообщения.\r\n\r\nПри успехе ссылка будет скопирована в буфер обмена.\r\n\r\nЗагрузить?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Это изображение будет загружено в ИНТЕРНЕТ — «catbox.moe».\r\n\r\n• Оно НЕ появится ни в какой публичной галерее / поиске (без публикации).\r\n• Но любой, у кого есть ссылка, сможет открыть изображение.\r\n• Поскольку загрузка анонимная, ВЫ НЕ СМОЖЕТЕ удалить его самостоятельно.\r\n• Изображение не зашифровано.\r\n• НЕ загружайте КОНФИДЕНЦИАЛЬНОЕ содержимое: удостоверения, пароли, личные сообщения.\r\n\r\nПри успехе ссылка будет скопирована в буфер обмена.\r\n\r\nЗагрузить?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Загрузка в интернет"

