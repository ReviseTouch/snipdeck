#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "Быстрый, бесплатный инструмент с открытым исходным кодом для снимков экрана в Windows и Linux."

msgid "About Snipdeck"
msgstr "О Snipdeck"

msgid "Add at least two snips to make a collage."
msgstr "Чтобы создать коллаж, добавьте не менее двух снимков."

msgid "Asked once; your answer is remembered."
msgstr "Спрашиваем один раз — ваш ответ запоминается."

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "Выделите область экрана с Super + Alt + перетаскивание."

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "Выделите область экрана кнопкой «Новый» или горячей клавишей."

msgid "Collage"
msgstr "Коллаж"

msgid "Colour picker unavailable: {e}"
msgstr "Выбор цвета недоступен: {e}"

msgid "Combine several snips into one collage"
msgstr "Объединить несколько снимков в один коллаж"

msgid "Copy the snip image to the clipboard"
msgstr "Скопировать изображение снимка в буфер обмена"

msgid "Crop by dragging the edges inward"
msgstr "Обрезать, перетаскивая края внутрь"

msgid "Delete all {} snips?"
msgstr "Удалить все снимки ({})?"

msgid "Delete the snip permanently"
msgstr "Удалить снимок навсегда"

msgid "Delete {} unpinned snips?"
msgstr "Удалить незакреплённые снимки ({})?"

msgid "Discard"
msgstr "Отбросить"

msgid "Discard your annotations?"
msgstr "Отбросить аннотации?"

msgid "Draw and mark up the snip"
msgstr "Рисовать и делать пометки на снимке"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "Будут удалены все снимки, включая закреплённые. Изображения удаляются с диска без возможности восстановления."

msgid "Everything drawn since the editor opened will be lost."
msgstr "Всё, что нарисовано с момента открытия редактора, будет потеряно."

msgid "Failed to open annotation editor: {e}"
msgstr "Не удалось открыть редактор аннотаций: {e}"

msgid "Failed to open collage: {e}"
msgstr "Не удалось открыть коллаж: {e}"

msgid "Failed to open window: {e}"
msgstr "Не удалось открыть окно: {e}"

msgid "Failed to read image: {e}"
msgstr "Не удалось прочитать изображение: {e}"

msgid "Failed to save snip: {e}"
msgstr "Не удалось сохранить снимок: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "Завершите или отмените открытую аннотацию, прежде чем начинать новую."

msgid "Flip horizontally"
msgstr "Отразить по горизонтали"

msgid "Flip vertically"
msgstr "Отразить по вертикали"

msgid "Gap"
msgstr "Отступ"

msgid "Hide from screen (stays in the gallery)"
msgstr "Убрать с экрана (останется в галерее)"

msgid "Hover an item to see what it does"
msgstr "Наведите на пункт, чтобы узнать, что он делает"

msgid "Keep editing"
msgstr "Продолжить правку"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "Создано ReviseTouch — мы делаем инструменты для разработчиков и ИИ-продукты."

msgid "New email with the snip attached"
msgstr "Новое письмо со снимком во вложении"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "OCR + Перевод распознаёт текст на этом снимке прямо на вашем компьютере, а затем отправляет этот текст — не изображение — в Google Translate (translate.googleapis.com). Больше ничто в Snipdeck ничего не отправляет, не спросив вас."

msgid "Open in the system image editor"
msgstr "Открыть в системном редакторе изображений"

msgid "Open the main Snipdeck window"
msgstr "Открыть главное окно Snipdeck"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "Выбрать цвет в любом месте экрана — за курсором следует лупа, щёлкните, чтобы взять цвет"

msgid "Pick a color from this snip with the magnifier"
msgstr "Выбрать цвет на этом снимке с помощью лупы"

msgid "Pick color"
msgstr "Выбрать цвет"

msgid "Pick images from the tray below to build a collage"
msgstr "Выберите изображения на панели ниже, чтобы собрать коллаж"

msgid "Picked color"
msgstr "Выбранный цвет"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "Закреплённые снимки останутся. Изображения удаляются с диска без возможности восстановления."

msgid "Read the text in the image and copy it"
msgstr "Распознать текст на изображении и скопировать его"

msgid "Read the text, then translate it"
msgstr "Распознать текст и перевести его"

msgid "Resize with the corner handles"
msgstr "Изменить размер с помощью угловых маркеров"

msgid "Rotate 180°"
msgstr "Повернуть на 180°"

msgid "Rotate 90° left"
msgstr "Повернуть на 90° влево"

msgid "Rotate 90° right"
msgstr "Повернуть на 90° вправо"

msgid "Round"
msgstr "Скругление"

msgid "Run as administrator"
msgstr "Запустить от имени администратора"

msgid "Send"
msgstr "Отправить"

msgid "Send the text to Google?"
msgstr "Отправить текст в Google?"

msgid "Settings could not be read and were reset. The old file is kept as {path}"
msgstr "Не удалось прочитать настройки, они сброшены. Старый файл сохранён как {path}"

msgid "Share via the Windows share sheet"
msgstr "Поделиться через панель «Поделиться» Windows"

msgid "Snipping needs pointer access this session does not grant."
msgstr "Для снимка нужен доступ к указателю, который этот сеанс не предоставляет."

msgid "Support"
msgstr "Поддержка"

msgid "Take a new snip"
msgstr "Сделать новый снимок"

msgid "Take a new snip — or drag a region with Super + Alt"
msgstr "Сделать новый снимок — или выделите область с Super + Alt"

msgid "The colour picker needs pointer access this session does not grant."
msgstr "Для выбора цвета нужен доступ к указателю, который этот сеанс не предоставляет."

msgid "Upload to an image host, copy the link"
msgstr "Загрузить на фотохостинг и скопировать ссылку"

msgid "Version"
msgstr "Версия"

msgid "Visit ReviseTouch"
msgstr "Посетить ReviseTouch"

msgid "eyedropper"
msgstr "пипетка"

