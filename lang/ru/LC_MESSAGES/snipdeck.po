msgstr "Добавить из файла .sxcu…"

msgid "Remove this host"
msgstr "Удалить этот хостинг"

msgid "Upload this snip?"
msgstr "Загрузить этот снимок?"

msgid "Uploading…"
msgstr "Загрузка…"

msgid "Uploaded"
msgstr "Загружено"

msgid "Upload failed"
msgstr "Ошибка загрузки"

msgid "Imgur needs a Client-ID"
msgstr "Для Imgur нужен Client-ID"

msgid "Anyone with the link can open the image."
msgstr "Открыть изображение может любой, у кого есть ссылка."

msgid "It is not listed or searchable anywhere."
msgstr "Оно нигде не попадает в списки и не находится поиском."

msgid "Uploaded anonymously, it cannot be deleted later."
msgstr "Загружается анонимно — потом его нельзя будет удалить."

msgid "The connection is not encrypted: others on the network can see the image."
msgstr "Соединение не зашифровано: другие в сети могут увидеть изображение."

msgid "Don't upload IDs, passwords or private messages."
msgstr "Не загружайте документы, пароли и личную переписку."

msgid "When it is done, the link is copied to the clipboard."
msgstr "Когда загрузка завершится, ссылка будет скопирована в буфер обмена."

msgid "The link is on the clipboard."
msgstr "Ссылка в буфере обмена."

msgid "The link could not be copied; use Copy link."
msgstr "Не удалось скопировать ссылку; нажмите «Копировать ссылку»."

msgid "Imgur's anonymous uploads need a free Client-ID. Register an application at imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), put its Client-ID in the settings file as \"imgur_client_id\", and restart Snipdeck."
msgstr "Для анонимной загрузки в Imgur нужен бесплатный Client-ID. Зарегистрируйте приложение на imgur.com → Settings → Applications (\"OAuth 2 without a callback URL\"), укажите его Client-ID в файле настроек как \"imgur_client_id\" и перезапустите Snipdeck."

msgid "Upload"
msgstr "Загрузить"

msgid "Hide"
msgstr "Скрыть"

msgid "Copy link"
msgstr "Копировать ссылку"

msgid "Open link"
msgstr "Открыть ссылку"

msgid "Open settings file"
msgstr "Открыть файл настроек"

msgid "Try again"
msgstr "Повторить"

msgid "This file is not a ShareX custom uploader."
msgstr "Этот файл не является пользовательским загрузчиком ShareX."

msgid "It sends the image as \"{body}\"; Snipdeck can send multipart form data or a binary body."
msgstr "Он отправляет изображение как \"{body}\"; Snipdeck умеет отправлять данные формы multipart или двоичное тело запроса."

msgid "It must upload to an http:// or https:// address."
msgstr "Он должен загружать на адрес http:// или https://."

msgid "Only POST, PUT and PATCH uploads are supported."
msgstr "Поддерживается только загрузка методами POST, PUT и PATCH."

msgid "It uploads text or shortens links, not images."
msgstr "Он загружает текст или сокращает ссылки, а не изображения."

msgid "It does not say which form field carries the image (FileFormName)."
msgstr "В нём не указано, в каком поле формы передаётся изображение (FileFormName)."

msgid "The host answered without a link: {answer}"
msgstr "Хостинг ответил без ссылки: {answer}"

msgid "It uses {what}, which Snipdeck does not support."
msgstr "Он использует {what}, что Snipdeck не поддерживает."

msgid "The host's answer has no {what}."
msgstr "В ответе хостинга нет {what}."

msgid "Could not reach {host}: {e}"
msgstr "Не удалось подключиться к {host}: {e}"

msgid "Could not add the upload host: {why}"
msgstr "Не удалось добавить хостинг для загрузки: {why}"
