#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "تصویر بارگذاری شد.\r\nپیوند در کلیپ‌بورد کپی شد:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "تصویر بارگذاری شد:\r\n{url}\r\n\r\n(نمی‌توان پیوند را در کلیپ‌بورد کپی کرد.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — بارگذاری"

msgid "Upload failed:\r\n{err}"
msgstr "بارگذاری ناموفق بود:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Client-ID مربوط به Imgur تنظیم نشده — بارگذاری ممکن نیست.\r\n\r\n۱) یک Client-ID رایگان دریافت کنید:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n۲) آن را به این فایل اضافه کنید:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n۳) Snipdeck را مجدداً راه‌اندازی کنید."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Client-ID مربوط به Imgur لازم است"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "این تصویر به اینترنت — \"Imgur\" (ناشناس) بارگذاری خواهد شد.\r\n\r\n• در صفحه اصلی / گالری Imgur ظاهر نخواهد شد (پنهان، فهرست‌نشده).\r\n• اما هر کسی که پیوند را داشته باشد می‌تواند تصویر را باز کند.\r\n• تصویر رمزگذاری نشده است.\r\n• محتوای حساس مانند شناسه‌ها، رمزهای عبور یا پیام‌های خصوصی را بارگذاری نکنید.\r\n\r\nدر صورت موفقیت، پیوند در کلیپ‌بورد کپی می‌شود.\r\n\r\nبارگذاری شود؟"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "این تصویر به اینترنت — \"catbox.moe\" بارگذاری خواهد شد.\r\n\r\n• در هیچ گالری عمومی / جستجویی ظاهر نخواهد شد (فهرست‌نشده).\r\n• اما هر کسی که پیوند را داشته باشد می‌تواند تصویر را باز کند.\r\n• چون به صورت ناشناس بارگذاری می‌شود، بعداً نمی‌توانید آن را خودتان حذف کنید.\r\n• تصویر رمزگذاری نشده است.\r\n• محتوای حساس مانند شناسه‌ها، رمزهای عبور یا پیام‌های خصوصی را بارگذاری نکنید.\r\n\r\nدر صورت موفقیت، پیوند در کلیپ‌بورد کپی می‌شود.\r\n\r\nبارگذاری شود؟"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — بارگذاری در اینترنت"

