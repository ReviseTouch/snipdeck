#. ── Share / mail dialogs ──
msgid "The image has been copied to the clipboard.\r\nPaste it into the open email with Ctrl+V."
msgstr "تصویر در کلیپ‌بورد کپی شد.\r\nآن را با Ctrl+V در ایمیل باز شده جای‌گذاری کنید."

msgid "The email opened, but the image could not be copied to the clipboard.\r\nCopy the snip again and paste it with Ctrl+V."
msgstr "ایمیل باز شد، اما تصویر نتوانست در کلیپ‌بورد کپی شود.\r\nدوباره تصویر را کپی کنید و با Ctrl+V جای‌گذاری کنید."

msgid "Snipdeck — Attach to email"
msgstr "Snipdeck — پیوست به ایمیل"

msgid "Language"
msgstr "زبان"

