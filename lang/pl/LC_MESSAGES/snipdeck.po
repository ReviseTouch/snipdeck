#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Obraz przesłany.\r\nLink skopiowany do schowka:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Obraz przesłany:\r\n{url}\r\n\r\n(Nie udało się skopiować linku do schowka.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Przesyłanie"

msgid "Upload failed:\r\n{err}"
msgstr "Przesyłanie nie powiodło się:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Nie skonfigurowano Imgur Client-ID — nie można przesłać.\r\n\r\n1) Uzyskaj bezpłatny Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Dodaj go do tego pliku:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Uruchom ponownie Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Wymagany Imgur Client-ID"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Ten obraz zostanie przesłany do INTERNETU — \"Imgur\" (anonimowo).\r\n\r\n• NIE pojawi się na stronie głównej / galerii Imgur (ukryty, niewidoczny).\r\n• Ale każdy, kto ma wynikowy link, może otworzyć obraz.\r\n• Obraz nie jest szyfrowany.\r\n• NIE przesyłaj WRAŻLIWYCH treści, takich jak identyfikatory, hasła lub prywatne wiadomości.\r\n\r\nPo pomyślnym przesłaniu link zostanie skopiowany do schowka.\r\n\r\nPrzesłać?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Ten obraz zostanie przesłany do INTERNETU — \"catbox.moe\".\r\n\r\n• NIE pojawi się w żadnej publicznej galerii / wyszukiwaniu (niewidoczny).\r\n• Ale każdy, kto ma wynikowy link, może otworzyć obraz.\r\n• Ponieważ jest przesyłany anonimowo, NIE MOŻESZ go później samodzielnie usunąć.\r\n• Obraz nie jest szyfrowany.\r\n• NIE przesyłaj WRAŻLIWYCH treści, takich jak identyfikatory, hasła lub prywatne wiadomości.\r\n\r\nPo pomyślnym przesłaniu link zostanie skopiowany do schowka.\r\n\r\nPrzesłać?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Prześlij do internetu"

