#. ── Added October 2026 ──
msgid "A fast, free, open-source screen-snipping deck for Windows and Linux."
msgstr "Windows ও Linux-এর জন্য একটি দ্রুত, বিনামূল্যের, ওপেন-সোর্স স্ক্রিন-স্নিপিং টুল।"

msgid "About Snipdeck"
msgstr "Snipdeck সম্পর্কে"

msgid "Add at least two snips to make a collage."
msgstr "কোলাজ তৈরি করতে অন্তত দুটি স্নিপ যোগ করুন।"

msgid "Asked once; your answer is remembered."
msgstr "শুধু একবার জিজ্ঞাসা করা হয়; আপনার উত্তর মনে রাখা হবে।"

msgid "Capture a region from the screen with Super + Alt + drag."
msgstr "Super + Alt + টেনে স্ক্রিন থেকে একটি এলাকা ক্যাপচার করুন।"

msgid "Capture a region from the screen with the New button or a hotkey."
msgstr "নতুন বোতাম বা একটি হটকি দিয়ে স্ক্রিন থেকে একটি এলাকা ক্যাপচার করুন।"

msgid "Collage"
msgstr "কোলাজ"

msgid "Colour picker unavailable: {e}"
msgstr "রঙ নির্বাচক উপলব্ধ নেই: {e}"

msgid "Combine several snips into one collage"
msgstr "একাধিক স্নিপ মিলিয়ে একটি কোলাজ তৈরি করুন"

msgid "Copy the snip image to the clipboard"
msgstr "স্নিপের ছবি ক্লিপবোর্ডে কপি করুন"

msgid "Crop by dragging the edges inward"
msgstr "কিনারা ভেতরে টেনে ক্রপ করুন"

msgid "Delete all {} snips?"
msgstr "সব {}টি স্নিপ মুছবেন?"

msgid "Delete the snip permanently"
msgstr "স্নিপটি স্থায়ীভাবে মুছুন"

msgid "Delete {} unpinned snips?"
msgstr "আনপিন করা {}টি স্নিপ মুছবেন?"

msgid "Discard"
msgstr "বাদ দিন"

msgid "Discard your annotations?"
msgstr "আপনার টীকাগুলো বাদ দেবেন?"

msgid "Draw and mark up the snip"
msgstr "স্নিপে আঁকুন ও চিহ্নিত করুন"

msgid "Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored."
msgstr "পিন করাগুলোসহ সব স্নিপ মুছে যাবে। ছবিগুলো ডিস্ক থেকে মুছে ফেলা হবে এবং ফিরিয়ে আনা যাবে না।"

msgid "Everything drawn since the editor opened will be lost."
msgstr "এডিটর খোলার পর থেকে আঁকা সবকিছু হারিয়ে যাবে।"

msgid "Failed to open annotation editor: {e}"
msgstr "টীকা এডিটর খুলতে ব্যর্থ: {e}"

msgid "Failed to open collage: {e}"
msgstr "কোলাজ খুলতে ব্যর্থ: {e}"

msgid "Failed to open window: {e}"
msgstr "উইন্ডো খুলতে ব্যর্থ: {e}"

msgid "Failed to read image: {e}"
msgstr "ছবি পড়তে ব্যর্থ: {e}"

msgid "Failed to save snip: {e}"
msgstr "স্নিপ সংরক্ষণ করতে ব্যর্থ: {e}"

msgid "Finish or cancel the open annotation before starting another."
msgstr "আরেকটি শুরু করার আগে খোলা টীকাটি শেষ বা বাতিল করুন।"

msgid "Flip horizontally"
msgstr "অনুভূমিকভাবে উল্টান"

msgid "Flip vertically"
msgstr "উল্লম্বভাবে উল্টান"

msgid "Gap"
msgstr "ব্যবধান"

msgid "Hide from screen (stays in the gallery)"
msgstr "স্ক্রিন থেকে লুকান (গ্যালারিতে থেকে যাবে)"

msgid "Hover an item to see what it does"
msgstr "কোনো আইটেম কী করে দেখতে তার ওপর মাউস রাখুন"

msgid "Keep editing"
msgstr "সম্পাদনা চালিয়ে যান"

msgid "Made by ReviseTouch — we build developer tools & AI products."
msgstr "ReviseTouch-এর তৈরি — আমরা ডেভেলপার টুল ও AI পণ্য তৈরি করি।"

msgid "New email with the snip attached"
msgstr "স্নিপ সংযুক্ত করে নতুন ইমেইল"

msgid "OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking."
msgstr "OCR + অনুবাদ এই স্নিপের টেক্সট আপনার কম্পিউটারেই পড়ে, তারপর সেই টেক্সট — ছবি নয় — Google Translate-এ (translate.googleapis.com) পাঠায়। Snipdeck-এর অন্য কিছুই জিজ্ঞাসা না করে কিছু পাঠায় না।"

msgid "Open in the system image editor"
msgstr "সিস্টেমের ইমেজ এডিটরে খুলুন"

msgid "Open the main Snipdeck window"
msgstr "Snipdeck-এর প্রধান উইন্ডো খুলুন"

msgid "Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"
msgstr "স্ক্রিনের যেকোনো জায়গা থেকে রঙ বাছুন — একটি বিবর্ধক কার্সর অনুসরণ করে, নিতে ক্লিক করুন"

msgid "Pick a color from this snip with the magnifier"
msgstr "বিবর্ধক দিয়ে এই স্নিপ থেকে রঙ বাছুন"

msgid "Pick color"
msgstr "রঙ বাছুন"

msgid "Pick images from the tray below to build a collage"
msgstr "কোলাজ তৈরি করতে নিচের ট্রে থেকে ছবি বাছুন"

msgid "Picked color"
msgstr "বাছাই করা রঙ"

msgid "Pinned snips stay. The images are deleted from disk and cannot be restored."
msgstr "পিন করা স্নিপগুলো থেকে যাবে। ছবিগুলো ডিস্ক থেকে মুছে ফেলা হবে এবং ফিরিয়ে আনা যাবে না।"

msgid "Read the text in the image and copy it"
msgstr "ছবির টেক্সট পড়ে কপি করুন"

msgid "Read the text, then translate it"
msgstr "টেক্সট পড়ুন, তারপর অনুবাদ করুন"

msgid "Resize with the corner handles"
