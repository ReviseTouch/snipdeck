#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Imaginea a fost încărcată.\r\nLink copiat în clipboard:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Imaginea a fost încărcată:\r\n{url}\r\n\r\n(Link-ul nu a putut fi copiat în clipboard.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Încărcare"

msgid "Upload failed:\r\n{err}"
msgstr "Încărcarea a eșuat:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Niciun Imgur Client-ID configurat — încărcarea nu este posibilă.\r\n\r\n1) Obține un Client-ID gratuit:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Adaugă-l în acest fișier:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Repornește Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Imgur Client-ID necesar"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Această imagine va fi încărcată pe INTERNET — \"Imgur\" (anonim).\r\n\r\n• NU va apărea pe pagina principală / galeria Imgur (ascunsă, nelistată).\r\n• Dar oricine deține link-ul rezultat poate deschide imaginea.\r\n• Imaginea nu este criptată.\r\n• NU încărca conținut SENSIBIL, cum ar fi ID-uri, parole sau mesaje private.\r\n\r\nÎn caz de succes, link-ul este copiat în clipboard.\r\n\r\nÎncarcă?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Această imagine va fi încărcată pe INTERNET — \"catbox.moe\".\r\n\r\n• NU va apărea în nicio galerie / căutare publică (nelistată).\r\n• Dar oricine deține link-ul rezultat poate deschide imaginea.\r\n• Deoarece este încărcată anonim, NU O POȚI ȘTERGE singur mai târziu.\r\n• Imaginea nu este criptată.\r\n• NU încărca conținut SENSIBIL, cum ar fi ID-uri, parole sau mesaje private.\r\n\r\nÎn caz de succes, link-ul este copiat în clipboard.\r\n\r\nÎncarcă?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Încărcare pe internet"

