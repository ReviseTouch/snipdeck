#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Image téléversée.\r\nLien copié dans le presse-papiers :\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Image téléversée :\r\n{url}\r\n\r\n(Impossible de copier le lien dans le presse-papiers.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Téléversement"

msgid "Upload failed:\r\n{err}"
msgstr "Échec du téléversement :\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Aucun Imgur Client-ID configuré — impossible de téléverser.\r\n\r\n1) Obtenez un Client-ID gratuit :\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Ajoutez-le dans ce fichier :\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Redémarrez Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Imgur Client-ID requis"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Cette image sera téléversée sur INTERNET — \"Imgur\" (anonyme).\r\n\r\n• Elle N'apparaîtra PAS sur la page d'accueil / galerie Imgur (masquée, non répertoriée).\r\n• Mais toute personne disposant du lien pourra ouvrir l'image.\r\n• L'image n'est pas chiffrée.\r\n• Ne téléversez PAS de contenu SENSIBLE tel que des identifiants, mots de passe ou messages privés.\r\n\r\nEn cas de succès, le lien est copié dans votre presse-papiers.\r\n\r\nTéléverser ?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Cette image sera téléversée sur INTERNET — \"catbox.moe\".\r\n\r\n• Elle N'apparaîtra PAS dans une galerie publique / les résultats de recherche (non répertoriée).\r\n• Mais toute personne disposant du lien pourra ouvrir l'image.\r\n• Étant téléversée anonymement, VOUS NE POURREZ PAS LA SUPPRIMER vous-même ultérieurement.\r\n• L'image n'est pas chiffrée.\r\n• Ne téléversez PAS de contenu SENSIBLE tel que des identifiants, mots de passe ou messages privés.\r\n\r\nEn cas de succès, le lien est copié dans votre presse-papiers.\r\n\r\nTéléverser ?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Téléverser sur internet"

