#. ── Error banners ({e} is the technical error detail; keep {e} verbatim) ──
msgid "Failed to register hotkeys: {e}"
msgstr "热键注册失败：{e}"

msgid "Failed to open floating window: {e}"
msgstr "悬浮窗口打开失败：{e}"

msgid "Failed to open menu: {e}"
msgstr "菜单打开失败：{e}"

msgid "Failed to reopen floating window: {e}"
msgstr "悬浮窗口重新打开失败：{e}"

msgid "Failed to copy to clipboard: {e}"
msgstr "复制到剪贴板失败：{e}"

msgid "Failed to copy text to clipboard: {e}"
msgstr "文字复制到剪贴板失败：{e}"

msgid "Failed to capture screen: {e}"
msgstr "屏幕截图失败：{e}"

msgid "Failed to freeze screen: {e}"
msgstr "屏幕冻结失败：{e}"

msgid "Failed to save image: {e}"
msgstr "图片保存失败：{e}"

msgid "Failed to save: {e}"
msgstr "保存失败：{e}"

msgid "Failed to crop region: {e}"
