msgstr "仅复制"

msgid "Close"
msgstr "关闭"

msgid "Reset"
msgstr "重置"

#. ── Toolbar / control tooltips ──
msgid "Take a new snip — drag a region with Win + left click"
msgstr "截取新图 — 按住 Win + 左键拖拽选区"

msgid "Take a snip and copy it to the clipboard"
msgstr "截图并复制到剪贴板"

msgid "Copy to the clipboard only (without saving to the gallery)"
msgstr "仅复制到剪贴板（不保存到图库）"

msgid "Hide on-screen snips"
msgstr "隐藏屏幕上的截图"

msgid "Show snips on screen"
msgstr "在屏幕上显示截图"

msgid "Show / hide floating snips in the taskbar"
msgstr "在任务栏显示/隐藏悬浮截图"

msgid "Clear unpinned snips"
msgstr "清除未固定的截图"

msgid "Clear all snips"
msgstr "清除所有截图"

msgid "Toggle light / dark theme"
msgstr "切换浅色/深色主题"

