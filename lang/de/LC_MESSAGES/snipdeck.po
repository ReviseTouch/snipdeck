#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Bild hochgeladen.\r\nLink in Zwischenablage kopiert:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Bild hochgeladen:\r\n{url}\r\n\r\n(Link konnte nicht in die Zwischenablage kopiert werden.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Upload"

msgid "Upload failed:\r\n{err}"
msgstr "Upload fehlgeschlagen:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Keine Imgur Client-ID konfiguriert — Upload nicht möglich.\r\n\r\n1) Kostenlose Client-ID erhalten:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) In diese Datei eintragen:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Snipdeck neu starten."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Imgur Client-ID erforderlich"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Dieses Bild wird ins INTERNET hochgeladen — \"Imgur\" (anonym).\r\n\r\n• Es erscheint NICHT auf der Imgur-Startseite / Galerie (verborgen, nicht gelistet).\r\n• Aber jeder mit dem erzeugten Link kann das Bild öffnen.\r\n• Das Bild ist nicht verschlüsselt.\r\n• Laden Sie KEINE SENSIBLEN Inhalte hoch, z. B. Ausweise, Passwörter oder private Nachrichten.\r\n\r\nBei Erfolg wird der Link in Ihre Zwischenablage kopiert.\r\n\r\nHochladen?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Dieses Bild wird ins INTERNET hochgeladen — \"catbox.moe\".\r\n\r\n• Es erscheint in KEINER öffentlichen Galerie / Suche (nicht gelistet).\r\n• Aber jeder mit dem erzeugten Link kann das Bild öffnen.\r\n• Da der Upload anonym erfolgt, KÖNNEN SIE ES SPÄTER NICHT SELBST LÖSCHEN.\r\n• Das Bild ist nicht verschlüsselt.\r\n• Laden Sie KEINE SENSIBLEN Inhalte hoch, z. B. Ausweise, Passwörter oder private Nachrichten.\r\n\r\nBei Erfolg wird der Link in Ihre Zwischenablage kopiert.\r\n\r\nHochladen?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Upload ins Internet"

