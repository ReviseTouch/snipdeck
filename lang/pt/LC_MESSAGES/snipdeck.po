#. ── Upload dialogs (\r\n = line breaks; keep them and {url}/{err}/{path}) ──
msgid "Image uploaded.\r\nLink copied to clipboard:\r\n{url}"
msgstr "Imagem enviada.\r\nLink copiado para a área de transferência:\r\n{url}"

msgid "Image uploaded:\r\n{url}\r\n\r\n(Could not copy the link to the clipboard.)"
msgstr "Imagem enviada:\r\n{url}\r\n\r\n(Não foi possível copiar o link para a área de transferência.)"

msgid "Snipdeck — Upload"
msgstr "Snipdeck — Enviar"

msgid "Upload failed:\r\n{err}"
msgstr "Falha no envio:\r\n{err}"

msgid "No Imgur Client-ID configured — cannot upload.\r\n\r\n1) Get a free Client-ID:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Add it to this file:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Restart Snipdeck."
msgstr "Nenhum Client-ID do Imgur configurado — não é possível enviar.\r\n\r\n1) Obtenha um Client-ID gratuito:\r\n   imgur.com → Settings → Applications → Register\r\n   (\"OAuth 2 authorization without a callback URL\")\r\n\r\n2) Adicione-o a este arquivo:\r\n   {path}\r\n   \"imgur_client_id\": \"YOUR_CLIENT_ID_HERE\"\r\n\r\n3) Reinicie o Snipdeck."

msgid "Snipdeck — Imgur Client-ID required"
msgstr "Snipdeck — Client-ID do Imgur necessário"

msgid "This image will be uploaded to the INTERNET — \"Imgur\" (anonymous).\r\n\r\n• It will NOT appear on the Imgur home page / gallery (hidden, unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Esta imagem será enviada para a INTERNET — \"Imgur\" (anônimo).\r\n\r\n• NÃO aparecerá na página inicial / galeria do Imgur (oculta, não listada).\r\n• Mas qualquer pessoa com o link resultante poderá abrir a imagem.\r\n• A imagem não é criptografada.\r\n• NÃO envie conteúdo SENSÍVEL como documentos, senhas ou mensagens privadas.\r\n\r\nSe bem-sucedido, o link é copiado para a área de transferência.\r\n\r\nEnviar?"

msgid "This image will be uploaded to the INTERNET — \"catbox.moe\".\r\n\r\n• It will NOT appear in any public gallery / search (unlisted).\r\n• But anyone who has the resulting link can open the image.\r\n• Because it is uploaded anonymously, YOU CANNOT DELETE IT yourself later.\r\n• The image is not encrypted.\r\n• Do NOT upload SENSITIVE content such as IDs, passwords, or private messages.\r\n\r\nOn success the link is copied to your clipboard.\r\n\r\nUpload?"
msgstr "Esta imagem será enviada para a INTERNET — \"catbox.moe\".\r\n\r\n• NÃO aparecerá em nenhuma galeria pública / busca (não listada).\r\n• Mas qualquer pessoa com o link resultante poderá abrir a imagem.\r\n• Por ser enviada anonimamente, VOCÊ NÃO PODERÁ EXCLUÍ-LA depois.\r\n• A imagem não é criptografada.\r\n• NÃO envie conteúdo SENSÍVEL como documentos, senhas ou mensagens privadas.\r\n\r\nSe bem-sucedido, o link é copiado para a área de transferência.\r\n\r\nEnviar?"

msgid "Snipdeck — Upload to the internet"
msgstr "Snipdeck — Enviar para a internet"

