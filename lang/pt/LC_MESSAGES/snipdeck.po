msgid "The email opened, but the image could not be copied to the clipboard.\r\nCopy the snip again and paste it with Ctrl+V."
msgstr "O e-mail foi aberto, mas a imagem não pôde ser copiada para a área de transferência.\r\nCopie o recorte novamente e cole com Ctrl+V."

msgid "Snipdeck — Attach to email"
msgstr "Snipdeck — Anexar ao e-mail"

