// Icon set — Feather / Lucide line glyphs.
//
// Every glyph is authored against a 24×24 viewbox with its visual mass
// centred on (12, 12). The Glyph deliberately leaves its `height` unset so
// that inside a HorizontalLayout it stretches to the row height (a fixed
// height child would be top-aligned by Slint's layout); the glyph then keeps
// itself centred via the `cx`/`cy` offsets below. In a manual placement the
// Glyph fills its parent and likewise stays centred.
//
// NOTE: a component's root element cannot read `parent`, so the centring
// offsets live on the Glyph and are passed to each StrokeGlyph/FillGlyph as
// x/y.

component StrokeGlyph inherits Path {
    in property <color> paint: #b8b6b1;
    in property <length> weight: 1.7px;
    in property <length> box: 16px;

    width: box;
    height: box;

    viewbox-width: 24;
    viewbox-height: 24;
    stroke: paint;
    stroke-width: weight;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
}

component FillGlyph inherits Path {
    in property <color> paint: #b8b6b1;
    in property <length> box: 16px;

    width: box;
    height: box;

    viewbox-width: 24;
    viewbox-height: 24;
    fill: paint;
    stroke: transparent;
}

export component Glyph inherits Rectangle {
    in property <string> name: "";
    in property <color> paint: #b8b6b1;
    in property <length> size: 16px;
    in property <length> weight: 1.7px;

    width: size;
    // height intentionally unset (see file header).
    background: transparent;

    // Centre offsets for the glyph inside this box. cx is 0 (width == size);
    // cy centres vertically against whatever height the layout gives us.
    property <length> cx: (self.width - size) / 2;
    property <length> cy: (self.height - size) / 2;

    if root.name == "plus" : StrokeGlyph {
        commands: "M12 5 L12 19 M5 12 L19 12";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "minus" : StrokeGlyph {
        commands: "M5 12 L19 12";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "x" : StrokeGlyph {
        commands: "M6 6 L18 18 M18 6 L6 18";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "copy" : StrokeGlyph {
        commands: "M11 9 L20 9 A2 2 0 0 1 22 11 L22 20 A2 2 0 0 1 20 22 L11 22 A2 2 0 0 1 9 20 L9 11 A2 2 0 0 1 11 9 Z M5 15 L4 15 A2 2 0 0 1 2 13 L2 4 A2 2 0 0 1 4 2 L13 2 A2 2 0 0 1 15 4 L15 6";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "clipboard" : StrokeGlyph {
        commands: "M16 4 L18 4 A2 2 0 0 1 20 6 L20 20 A2 2 0 0 1 18 22 L6 22 A2 2 0 0 1 4 20 L4 6 A2 2 0 0 1 6 4 L8 4 M9 2 L15 2 A1 1 0 0 1 16 3 L16 5 A1 1 0 0 1 15 6 L9 6 A1 1 0 0 1 8 5 L8 3 A1 1 0 0 1 9 2 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "eye" : StrokeGlyph {
        commands: "M2 12 C2 12 6 5 12 5 C18 5 22 12 22 12 C22 12 18 19 12 19 C6 19 2 12 2 12 Z M9 12 A3 3 0 0 1 15 12 A3 3 0 0 1 9 12 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "eye-off" : StrokeGlyph {
        commands: "M2 12 C2 12 6 5 12 5 C18 5 22 12 22 12 C22 12 18 19 12 19 C6 19 2 12 2 12 Z M9 12 A3 3 0 0 1 15 12 A3 3 0 0 1 9 12 Z M4 3 L20 21";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "window" : StrokeGlyph {
        commands: "M4 3 L20 3 A2 2 0 0 1 22 5 L22 15 A2 2 0 0 1 20 17 L4 17 A2 2 0 0 1 2 15 L2 5 A2 2 0 0 1 4 3 Z M8 21 L16 21 M12 17 L12 21";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "pin" : StrokeGlyph {
        commands: "M9 3 L15 3 M10.5 3 L10 10 L8 12 L16 12 L14 10 L13.5 3 M12 12 L12 21";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "pin-off" : StrokeGlyph {
        commands: "M9 3 L15 3 M10.5 3 L10 10 L8 12 L16 12 L14 10 L13.5 3 M12 12 L12 21 M3 3 L21 21";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "trash" : StrokeGlyph {
        commands: "M3 6 L21 6 M19 6 L19 20 A2 2 0 0 1 17 22 L7 22 A2 2 0 0 1 5 20 L5 6 M8 6 L8 4 A2 2 0 0 1 10 2 L14 2 A2 2 0 0 1 16 4 L16 6 M10 11 L10 17 M14 11 L14 17";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "sun" : StrokeGlyph {
        commands: "M12 7 A5 5 0 0 1 12 17 A5 5 0 0 1 12 7 Z M12 1 L12 3 M12 21 L12 23 M4.22 4.22 L5.64 5.64 M18.36 18.36 L19.78 19.78 M1 12 L3 12 M21 12 L23 12 M4.22 19.78 L5.64 18.36 M18.36 5.64 L19.78 4.22";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "moon" : FillGlyph {
        commands: "M21 12.79 A9 9 0 1 1 11.21 3 A7 7 0 0 0 21 12.79 Z";
        paint: root.paint; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "sliders" : StrokeGlyph {
        commands: "M4 21 L4 14 M4 10 L4 3 M12 21 L12 12 M12 8 L12 3 M20 21 L20 16 M20 12 L20 3 M2 14 L6 14 M10 8 L14 8 M18 16 L22 16";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "reset" : StrokeGlyph {
        commands: "M1 4 L1 10 L7 10 M3.51 15 A9 9 0 1 0 5.64 5.64 L1 10";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "save" : StrokeGlyph {
        commands: "M19 21 L5 21 A2 2 0 0 1 3 19 L3 5 A2 2 0 0 1 5 3 L16 3 L21 8 L21 19 A2 2 0 0 1 19 21 Z M17 21 L17 13 L7 13 L7 21 M7 3 L7 8 L15 8";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "search" : StrokeGlyph {
        commands: "M11 5 A6 6 0 1 0 11 17 A6 6 0 1 0 11 5 Z M15.24 15.24 L20 20";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "chevron-down" : StrokeGlyph {
        commands: "M6 9 L12 15 L18 9";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "resize" : StrokeGlyph {
        commands: "M15 3 L21 3 L21 9 M9 21 L3 21 L3 15 M21 3 L14 10 M3 21 L10 14";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "wand" : StrokeGlyph {
        commands: "M12 3 L13.8 10.2 L21 12 L13.8 13.8 L12 21 L10.2 13.8 L3 12 L10.2 10.2 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    if root.name == "more" : StrokeGlyph {
        commands: "M5 12 A0.6 0.6 0 1 0 5.01 12 Z M12 12 A0.6 0.6 0 1 0 12.01 12 Z M19 12 A0.6 0.6 0 1 0 19.01 12 Z";
        paint: root.paint; weight: 2.4px; box: root.size; x: root.cx; y: root.cy;
    }

    // Clockwise refresh arrow (rotate right) — horizontal mirror of "reset".
    if root.name == "rotate-cw" : StrokeGlyph {
        commands: "M23 4 L23 10 L17 10 M20.49 15 A9 9 0 1 1 18.36 5.64 L23 10";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Flip horizontal — two triangles meeting at a dashed vertical axis.
    if root.name == "flip-h" : StrokeGlyph {
        commands: "M3 7 L8 12 L3 17 Z M21 7 L16 12 L21 17 Z M12 4 L12 6 M12 9 L12 15 M12 18 L12 20";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Flip vertical — two triangles meeting at a dashed horizontal axis.
    if root.name == "flip-v" : StrokeGlyph {
        commands: "M7 3 L12 8 L17 3 Z M7 21 L12 16 L17 21 Z M4 12 L6 12 M9 12 L15 12 M18 12 L20 12";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Crop marks — two overlapping L brackets (Lucide-style).
    if root.name == "crop" : StrokeGlyph {
        commands: "M6 2 L6 16 A2 2 0 0 0 8 18 L22 18 M2 6 L16 6 A2 2 0 0 1 18 8 L18 22";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Translate / languages (Lucide "languages"): CJK-ish strokes on the
    // left, a small latin "A" on the right.
    if root.name == "translate" : StrokeGlyph {
        commands: "M5 8 L11 14 M4 14 L10 8 L12 5 M2 5 H14 M7 2 H8 M22 22 L17 12 L12 22 M14 18 H20";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Share (Lucide "share-2"): three nodes joined by two links.
    if root.name == "share" : StrokeGlyph {
        commands: "M18 2 A3 3 0 1 0 18 8 A3 3 0 1 0 18 2 M6 9 A3 3 0 1 0 6 15 A3 3 0 1 0 6 9 M18 16 A3 3 0 1 0 18 22 A3 3 0 1 0 18 16 M8.6 13.5 L15.4 17.5 M15.4 6.5 L8.6 10.5";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Mail envelope.
    if root.name == "mail" : StrokeGlyph {
        commands: "M4 4 L20 4 A2 2 0 0 1 22 6 L22 18 A2 2 0 0 1 20 20 L4 20 A2 2 0 0 1 2 18 L2 6 A2 2 0 0 1 4 4 Z M2 7 L12 13 L22 7";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Paintbrush (Lucide "brush") — a diagonal handle/ferrule with a bristle
    // blob at the lower-left. Used for "open in the image editor (Paint)".
    if root.name == "brush" : StrokeGlyph {
        commands: "M8.5 11.5 L17 3 A2 2 0 0 1 21 7 L12.5 15.5 Z M8 13.2 C6 13.2 4.5 14.8 4.5 16.7 C4.5 18 2.7 18.3 3.4 18.9 C4.5 20 6.2 20.7 7.8 20.7 C9.9 20.7 11.6 19 11.6 16.9 A3.4 3.4 0 0 0 8 13.2 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Upload (Feather "upload") — a tray with an up-arrow rising out of it.
    // Used for "upload to Imgur".
    if root.name == "upload" : StrokeGlyph {
        commands: "M21 15 L21 19 A2 2 0 0 1 19 21 L5 21 A2 2 0 0 1 3 19 L3 15 M7 10 L12 5 L17 10 M12 5 L12 15";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Globe (Feather "globe") — a circle with an equator line and a symmetric
    // meridian ellipse. Used for the UI language menu.
    if root.name == "globe" : StrokeGlyph {
        commands: "M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M2 12 L22 12 M12 2 A5 10 0 1 0 12 22 A5 10 0 1 0 12 2 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Power (Feather "power") — an open-top ring with a vertical stem. Used for
    // the "launch at login" toggle.
    if root.name == "power" : StrokeGlyph {
        commands: "M18.36 6.64 A9 9 0 1 1 5.64 6.64 M12 2 L12 12";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // --- Annotation editor tools ---

    // Pencil (Feather "edit-2") — freehand pen tool.
    if root.name == "pencil" : StrokeGlyph {
        commands: "M16 3 L21 8 L8 21 L3 21 L3 16 Z M14 5 L19 10";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Highlighter — a chisel-nib marker laying down a stroke.
    if root.name == "highlighter" : StrokeGlyph {
        commands: "M3 21 L7 21 L19 9 L15 5 L3 17 Z M13 7 L17 11";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Hollow square — the rectangle tool.
    if root.name == "square" : StrokeGlyph {
        commands: "M4 4 L20 4 L20 20 L4 20 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Circle — the ellipse tool.
    if root.name == "circle" : StrokeGlyph {
        commands: "M12 4 A8 8 0 1 0 12 20 A8 8 0 1 0 12 4 Z";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Diagonal line — the line tool.
    if root.name == "line" : StrokeGlyph {
        commands: "M5 19 L19 5";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Arrow pointing up-right — the arrow tool.
    if root.name == "arrow-ur" : StrokeGlyph {
        commands: "M6 18 L18 6 M9 6 L18 6 L18 15";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Curved arrow to the left — undo.
    if root.name == "undo" : StrokeGlyph {
        commands: "M9 14 L4 9 L9 4 M4 9 L15 9 A5 5 0 0 1 15 19 L11 19";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }

    // Curved arrow to the right — redo (mirror of undo).
    if root.name == "redo" : StrokeGlyph {
        commands: "M15 14 L20 9 L15 4 M20 9 L9 9 A5 5 0 0 0 9 19 L13 19";
        paint: root.paint; weight: root.weight; box: root.size; x: root.cx; y: root.cy;
    }
}
