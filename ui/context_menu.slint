// Floating snip right-click context menu.
//
// One borderless slint::Window per floating snip, opened at the screen
// position of the right click. Items emit a `picked(action)` callback
// where `action` is one of the ContextAction values below; Rust dispatches.
//
// Action codes (int):
//   0 = Close (hide floating window, keep snip in gallery)
//   1 = Delete (remove snip from gallery entirely)
//   2 = Copy (snip image -> clipboard)
//   3 = Resize again (re-enable resize handles on this snip)
//   4 = Copy OCR (Windows OCR -> clipboard)
//   5 = Rotate left  (90° counter-clockwise)
//   6 = Rotate right (90° clockwise)
//   7 = Rotate 180°
//   8 = Flip horizontal
//   9 = Flip vertical
//  10 = Crop (inward-only handles -> real pixel crop on release)
//  11 = OCR + translate (popup)
//  12 = Share via the Windows share sheet
//  13 = Mail (new message with the snip attached, via MAPI)
//  14 = Open in the system image editor (Paint)
//  15 = Upload (upload to an image host, copy the link to the clipboard)

import { Glyph } from "icons.slint";

component MenuItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <string> hint: "";
    in property <color> icon-color: #8a8782;
    in property <bool> stub: false;
    in property <bool> danger: false;
    // One-line description shown in the menu's bottom strip while hovered.
    in property <string> tip: "";
    callback clicked();
    callback hovered(string);

    height: 28px;
    border-radius: 4px;
    background: ta.pressed && !stub ? (danger ? #5a2222 : #3a3a3a) : (ta.has-hover && !stub ? (danger ? #3a1a1a : #2a2a2a) : transparent);
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        // No `alignment` — let the label stretch so everything is
        // left-aligned (icon on the left, label flush-left, hint on the right).
        Rectangle {
            width: 26px;
            background: transparent;

            if root.icon == "ocr" : Text {
                text: "OCR";
                color: root.danger ? #e06363 : root.icon-color;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: 10px;
                font-weight: 700;
                width: 100%;
                height: 100%;
            }

            if root.icon != "ocr" : Glyph {
                name: root.icon;
                paint: root.danger ? #e06363 : root.icon-color;
                size: 15px;
                weight: 1.7px;
            }
        }
        Text {
            text: root.label;
            color: stub ? #5e5b56 : (danger ? #e06363 : #e8e6e2);
            vertical-alignment: center;
            horizontal-alignment: left;
            font-size: 12px;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.hint;
            color: #5e5b56;
            vertical-alignment: center;
            font-size: 10px;
            font-family: "Consolas";
        }
    }

    ta := TouchArea {
        changed has-hover => {
            if (self.has-hover && root.tip != "") { root.hovered(root.tip); }
        }
        clicked => { root.clicked(); }
    }
}

// Compact square button used in the "Transform" transform row.
component TransformBtn inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    // Glyph colour (idle / hover). Defaults match the neutral menu palette;
    // the share row overrides them (e.g. WhatsApp green).
    in property <color> tint: #b8b6b1;
    in property <color> tint-hover: #e8e6e2;
    // One-line description shown in the menu's bottom strip while hovered.
    in property <string> tip: "";
    callback clicked();
    callback hovered(string);

    height: 30px;
    min-width: 34px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: ta.pressed ? #3a3a3a : (ta.has-hover ? #2a2a2a : transparent);
    animate background { duration: 80ms; }

    if root.icon != "" : Glyph {
        name: root.icon;
        paint: ta.has-hover ? root.tint-hover : root.tint;
        size: 17px;
        weight: 1.7px;
        x: (parent.width - self.width) / 2;
    }
    if root.text != "" : Text {
        text: root.text;
        color: ta.has-hover ? #e8e6e2 : #b8b6b1;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    ta := TouchArea {
        changed has-hover => {
            if (self.has-hover && root.tip != "") { root.hovered(root.tip); }
        }
        clicked => { root.clicked(); }
    }
}

export component ContextMenuWindow inherits Window {
    title: "SnipdeckContextMenu";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    callback picked(int);
    callback dismissed();

    // "Show Snipdeck" is shown only for a floating snip's menu, not the gallery.
    in property <bool> show-app-item: true;
    // Which OCR engine reads the text, shown beside "OCR + Clipboard".
    in property <string> ocr-engine: "Win OCR";
    // The system share sheet exists only on Windows; elsewhere the button
    // could only fail, so it is not shown.
    in property <bool> system-share: true;
    // Description of the item the mouse is currently over, shown in the bottom
    // strip so every action — especially the icon-only Share/Transform buttons —
    // says what it does on hover.
    property <string> current-tip: "";

    // The menu panel's own size. Item stack + 20px header row + ~44px
    // hover-description strip.
    in property <length> menu-w: 220px;
    in property <length> menu-h: root.show-app-item ? 460px : 430px;

    // Where the panel sits inside this window, and how big the window is.
    //
    // On Windows the window IS the menu: `outer` matches `menu`, the offset is
    // zero, and the window is placed at the cursor with `set_position`.
    //
    // Wayland forbids a client from placing its own window, so there the window
    // is instead stretched over the whole screen (transparent) and the panel is
    // drawn at the cursor *inside* it. The protocol only governs where surfaces
    // go relative to each other — what we paint within our own surface is ours
    // to decide, so this recovers exact placement without the compositor's help.
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <length> outer-w: root.menu-w;
    in property <length> outer-h: root.menu-h;

    width: outer-w;
    height: outer-h;

    // Where the pointer is, in surface-local coordinates.
    //
    // On the screen-covering variant those ARE screen coordinates, which is the
    // only way this build can learn where the cursor is: Wayland tells a client
    // nothing about the pointer outside its own surfaces, and the right-click
    // that opened the menu arrived in the floating snip's window, whose position
    // on screen is equally unknowable. Cover the screen and the question answers
    // itself.
    callback pointer-at(length, length);

    // Held back until the anchor is known, so the panel appears at the cursor
    // rather than appearing centred and then jumping to it.
    in property <bool> panel-visible: true;

    // Anywhere on the surface that is not the panel dismisses. On Windows this
    // is the panel's own background (the window is menu-sized); on the
    // full-screen variant it is the rest of the screen, which is exactly the
    // "click elsewhere closes the menu" behaviour the Win32 build gets from
    // `poll_auto_close`.
    surface-ta := TouchArea {
        clicked => { root.dismissed(); }
        moved => { root.pointer-at(surface-ta.mouse-x, surface-ta.mouse-y); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.move) {
                root.pointer-at(surface-ta.mouse-x, surface-ta.mouse-y);
            }
        }
    }

    if root.panel-visible : Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-w;
        height: root.menu-h;
        background: #1c1c1c;
        border-radius: 6px;
        border-width: 1px;
        border-color: #3a3a3a;

        // Click on the panel background (but not on an item) closes the menu.
        TouchArea {
            clicked => { root.dismissed(); }
        }

        VerticalLayout {
            padding: 4px;
            spacing: 0px;

            // Top strip: a close (X) button, right-aligned. Clicking it — or
            // anywhere outside the menu — dismisses it without taking an action.
            HorizontalLayout {
                height: 20px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px;
                    border-radius: 4px;
                    background: close-ta.pressed ? #3a3a3a : (close-ta.has-hover ? #2a2a2a : transparent);
                    animate background { duration: 80ms; }
                    Glyph {
                        name: "x";
                        paint: close-ta.has-hover ? #e8e6e2 : #8a8782;
                        size: 14px;
                        weight: 1.7px;
                        x: (parent.width - self.width) / 2;
                    }
                    close-ta := TouchArea {
                        clicked => { root.dismissed(); }
                    }
                }
            }

            MenuItem {
                icon: "copy";
                label: @tr("Copy");
                hint: "img";
                tip: @tr("Copy the snip image to the clipboard");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(2); }
            }
            MenuItem {
                icon: "ocr";
                label: @tr("OCR + Clipboard");
                hint: root.ocr-engine;
                tip: @tr("Read the text in the image and copy it");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(4); }
            }
            MenuItem {
                icon: "translate";
                label: @tr("OCR + Translate");
                hint: @tr("translate");
                tip: @tr("Read the text, then translate it");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(11); }
            }
            MenuItem {
                icon: "wand";
                label: @tr("Pick color");
                hint: @tr("eyedropper");
                tip: @tr("Pick a color from this snip with the magnifier");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(18); }
            }
            if root.show-app-item : Rectangle { height: 1px; background: #262626; }
            if root.show-app-item : MenuItem {
                icon: "window";
                label: @tr("Show Snipdeck");
                tip: @tr("Open the main Snipdeck window");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(16); }
            }
            Rectangle {
                height: 22px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: @tr("Share");
                        color: #8a8782;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                // Windows share sheet (Mail/WhatsApp/Telegram… all appear there).
                if root.system-share: TransformBtn {
                    icon: "share";
                    tip: @tr("Share via the Windows share sheet");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(12); }
                }
                // Direct mail compose with the snip attached (MAPI).
                TransformBtn {
                    icon: "mail";
                    tip: @tr("New email with the snip attached");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(13); }
                }
                // Open in the system image editor (Paint).
                TransformBtn {
                    icon: "brush";
                    tip: @tr("Open in the system image editor");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(14); }
                }
                // Upload to an image host; the resulting link is copied.
                TransformBtn {
                    icon: "upload";
                    tip: @tr("Upload to an image host, copy the link");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(15); }
                }
            }
            Rectangle {
                height: 22px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: @tr("Transform");
                        color: #8a8782;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                TransformBtn {
                    icon: "reset";
                    tip: @tr("Rotate 90° left");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(5); }
                }
                TransformBtn {
                    icon: "rotate-cw";
                    tip: @tr("Rotate 90° right");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(6); }
                }
                TransformBtn {
                    text: "180°";
                    tip: @tr("Rotate 180°");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(7); }
                }
                TransformBtn {
                    icon: "flip-h";
                    tip: @tr("Flip horizontally");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(8); }
                }
                TransformBtn {
                    icon: "flip-v";
                    tip: @tr("Flip vertically");
                    hovered(t) => { root.current-tip = t; }
                    clicked => { root.picked(9); }
                }
            }
            Rectangle { height: 1px; background: #262626; }
            MenuItem {
                icon: "pencil";
                label: @tr("Annotate");
                hint: @tr("draw");
                tip: @tr("Draw and mark up the snip");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(17); }
            }
            MenuItem {
                icon: "crop";
                label: @tr("Crop");
                hint: @tr("drag inward");
                tip: @tr("Crop by dragging the edges inward");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(10); }
            }
            MenuItem {
                icon: "resize";
                label: @tr("Resize");
                hint: @tr("handles");
                tip: @tr("Resize with the corner handles");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(3); }
            }
            MenuItem {
                icon: "eye-off";
                label: @tr("Hide from screen");
                hint: @tr("hide");
                tip: @tr("Hide from screen (stays in the gallery)");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(0); }
            }
            Rectangle { height: 1px; background: #262626; }
            MenuItem {
                icon: "trash";
                label: @tr("Delete");
                hint: @tr("remove");
                danger: true;
                tip: @tr("Delete the snip permanently");
                hovered(t) => { root.current-tip = t; }
                clicked => { root.picked(1); }
            }

            // Hover-description strip: shows what the hovered item does. Keeps
            // every action — especially the icon-only Share/Transform buttons —
            // self-explanatory without cluttering each row.
            Rectangle { height: 1px; background: #262626; }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 5px;
                    Text {
                        text: root.current-tip != "" ? root.current-tip
                            : @tr("Hover an item to see what it does");
                        color: root.current-tip != "" ? #c8c6c2 : #6e6b66;
                        font-size: 10px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: top;
                    }
                }
            }
        }
    }
}
