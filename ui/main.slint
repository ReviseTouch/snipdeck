import { FloatingWindow } from "floating.slint";
import { OverlayWindow } from "overlay.slint";
import { ContextMenuWindow } from "context_menu.slint";
import { TranslatePopupWindow, TransLang } from "translate_popup.slint";
import { AnnotateWindow, AnnoShape } from "annotate.slint";
import { CollageWindow, CollageCell, TrayItem } from "collage.slint";
import { AboutWindow } from "about.slint";
import { LoupeWindow } from "loupe.slint";
import { ColorResultWindow } from "color_result.slint";
import { Glyph } from "icons.slint";
import { ListView, ScrollView } from "std-widgets.slint";

export { FloatingWindow, OverlayWindow, ContextMenuWindow, TranslatePopupWindow, TransLang, AnnotateWindow, AnnoShape, CollageWindow, CollageCell, TrayItem, AboutWindow, LoupeWindow, ColorResultWindow }

// Singleton holding the currently-hovered element's tooltip text + where to
// show it (window coords). MainWindow draws ONE overlay box from this, on top
// of everything, so a tooltip is never clipped by a sibling toolbar/filter row.
global Tips {
    in-out property <string> text: "";
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
}

export struct SnipItem {
    id: string,
    label: string,
    preview: string,
    preview_tag: string,
    dims: string,
    size_text: string,
    pinned: bool,
    floating: bool,
    has_ocr: bool,
    has_window: bool,
    monitor: string,
    source: string,
    created: string,
    thumb: image,
    aspect: float,
}

export struct LangItem {
    code: string,
    name: string,
}

component ToolbarButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "";
    in property <string> kbd: "";
    in property <bool> dark: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> active: false;
    in property <string> tooltip: "";
    callback clicked();

    property <color> fg: primary ? (dark ? #1a0e05 : #ffffff) : (danger && ta.has-hover ? (dark ? #f0a0a0 : #b83434) : (active ? (dark ? #ffb066 : #b85a14) : (dark ? #b8b6b1 : #3a3631)));

    height: 30px;
    border-radius: 6px;
    border-width: primary ? 1px : (active ? 1px : 0px);
    border-color: primary ? (dark ? #d96a1f : #b85a14) : (dark ? #4a3520 : #ecd3b0);
    background: ta.pressed
        ? (primary ? (dark ? #e5731f : #cc5f14)
            : (danger ? (dark ? #5a2222 : #f6cccc)
                : (dark ? #3a3a3a : #dedcd4)))
        : (primary
            ? (ta.has-hover ? (dark ? #ffa05c : #f08540) : (dark ? #ff8a3d : #e5731f))
            : (danger && ta.has-hover
                ? (dark ? #3a1a1a : #fbe6e6)
                : (active ? (dark ? #2a2520 : #fbe9d6) : (ta.has-hover ? (dark ? #262626 : #ecebe5) : transparent))));
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;

        if root.icon != "" : Glyph {
            name: root.icon;
            paint: root.fg;
            size: 17.25px;
            weight: 1.7px;
        }
        Text {
            text: root.label;
            color: root.fg;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.kbd != "" : Rectangle {
            height: 16px;
            min-width: 28px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.primary ? #00000044 : (root.dark ? #2a2a2a : #dcd9d1);
            background: root.primary ? #00000022 : (root.dark ? #0e0e0e : #f7f6f1);
            Text {
                text: root.kbd;
                color: root.primary ? #4a2810 : (root.dark ? #5e5b56 : #6e6962);
                font-size: 10px;
                font-family: "Consolas";
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tips.text = root.tooltip;
                Tips.x = root.absolute-position.x;
                Tips.y = root.absolute-position.y + root.height + 4px;
            } else if (Tips.text == root.tooltip) {
                Tips.text = "";
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <bool> dark: true;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <string> tooltip: "";
    callback clicked();

    property <color> fg: active ? (dark ? #ffb066 : #b85a14) : (danger && ta.has-hover ? (dark ? #f0a0a0 : #b83434) : (dark ? #b8b6b1 : #3a3631));

    width: 30px;
    height: 30px;
    border-radius: 6px;
    border-width: active ? 1px : 0px;
    border-color: active ? (dark ? #4a3520 : #ecd3b0) : transparent;
    background: ta.pressed
        ? (danger ? (dark ? #5a2222 : #f6cccc) : (dark ? #3a3a3a : #dedcd4))
        : (active ? (dark ? #2a2520 : #fbe9d6) : (ta.has-hover ? (danger ? (dark ? #3a1a1a : #fbe6e6) : (dark ? #262626 : #ecebe5)) : transparent));
    animate background { duration: 80ms; }

    Glyph {
        name: root.icon;
        paint: root.fg;
        size: 19.5px;
        weight: 1.7px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tips.text = root.tooltip;
                Tips.x = root.absolute-position.x;
                Tips.y = root.absolute-position.y + root.height + 4px;
            } else if (Tips.text == root.tooltip) {
                Tips.text = "";
            }
        }
    }
}

component FilterPill inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> dark: true;
    in property <bool> active: false;
    in property <string> tooltip: "";
    callback clicked();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? (dark ? #4a3520 : #ecd3b0) : (dark ? #2e2e2e : #dcd9d1);
    background: ta.pressed
        ? (active ? (dark ? #2e2620 : #f5ddc2) : (dark ? #242424 : #eeece4))
        : (active ? (dark ? #221d18 : #fbe9d6) : (ta.has-hover ? (dark ? #1c1c1c : #fbfaf6) : (dark ? #161616 : #ffffff)));
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.label;
            color: root.dark ? #5e5b56 : #6e6962;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.active ? (root.dark ? #ffb066 : #b85a14) : (root.dark ? #e8e6e2 : #1a1816);
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Glyph {
            name: "chevron-down";
            paint: root.dark ? #8a8782 : #6e6962;
            size: 13px;
            weight: 1.7px;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tips.text = root.tooltip;
                Tips.x = root.absolute-position.x;
                Tips.y = root.absolute-position.y + root.height + 4px;
            } else if (Tips.text == root.tooltip) {
                Tips.text = "";
            }
        }
    }
}

// Segmented S / M / L control for the gallery card size.
component SizeToggle inherits Rectangle {
    in property <bool> dark: true;
    in property <int> current: 1; // 0 = S, 1 = M, 2 = L
    in property <string> tooltip: "";
    callback changed(int);

    height: 30px;
    width: 90px;
    border-radius: 6px;
    border-width: 1px;
    border-color: dark ? #2e2e2e : #dcd9d1;
    background: dark ? #161616 : #ffffff;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for opt[i] in ["S", "M", "L"] : cell := Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            property <bool> sel: i == root.current;
            background: cell.sel
                ? (root.dark ? #2a2520 : #fbe9d6)
                : (cell-ta.pressed ? (root.dark ? #2e2e2e : #e6e5df) : (cell-ta.has-hover ? (root.dark ? #232323 : #f1f0ea) : transparent));
            animate background { duration: 80ms; }
            cell-ta := TouchArea {
                clicked => { root.changed(i); }
                changed has-hover => {
                    if (self.has-hover && root.tooltip != "") {
                        Tips.text = root.tooltip;
                        Tips.x = root.absolute-position.x;
                        Tips.y = root.absolute-position.y + root.height + 4px;
                    } else if (Tips.text == root.tooltip) {
                        Tips.text = "";
                    }
                }
            }
            Text {
                text: opt;
                color: cell.sel ? (root.dark ? #ffb066 : #b85a14) : (root.dark ? #8a8782 : #6e6962);
                font-size: 12px;
                font-weight: cell.sel ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component SearchBox inherits Rectangle {
    in-out property <string> value;
    in property <bool> dark: true;
    callback edited(string);
    callback cleared();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: dark ? #2e2e2e : #dcd9d1;
    background: dark ? #161616 : #ffffff;

    Glyph {
        name: "search";
        paint: root.dark ? #8a8782 : #6e6962;
        size: 15px;
        weight: 1.7px;
        x: 11px;
        y: (parent.height - self.height) / 2;
    }

    if root.value == "" : Text {
        x: 34px;
        y: 0px;
        width: parent.width - 45px;
        height: parent.height;
        text: @tr("text / OCR / window / monitor / path");
        color: root.dark ? #6f6b64 : #8c867d;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    TextInput {
        x: 34px;
        y: 0px;
        width: parent.width - 42px - (root.value != "" ? 24px : 0px);
        height: parent.height;
        color: root.dark ? #e8e6e2 : #1a1816;
        selection-background-color: #ff8a3d;
        selection-foreground-color: #1a0e05;
        font-size: 13px;
        single-line: true;
        vertical-alignment: center;
        text <=> root.value;
        edited => { root.edited(self.text); }
    }

    if root.value != "" : Rectangle {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 3px;
        background: clear-touch.pressed ? (root.dark ? #3a3a3a : #dcdad2) : (clear-touch.has-hover ? (root.dark ? #2a2a2a : #ecebe5) : transparent);
        animate background { duration: 80ms; }
        Glyph {
            name: "x";
            paint: clear-touch.has-hover ? (root.dark ? #e8e6e2 : #1a1816) : (root.dark ? #8a8782 : #6e6962);
            size: 13px;
            weight: 1.7px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        clear-touch := TouchArea {
            clicked => {
                root.value = "";
                root.cleared();
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text: "";
    in property <color> bg: #000000aa;
    in property <color> fg: #b8b6b1;
    in property <length> chip-width: 42px;

    width: chip-width;
    height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: #00000088;
    background: bg;

    Text {
        text: root.text;
        color: root.fg;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        overflow: elide;
    }
}

component CardAction inherits Rectangle {
    in property <string> icon: "";
    in property <bool> dark: true;
    in property <bool> active_pin: false;
    in property <bool> active_float: false;
    in property <bool> danger: false;
    // Exposed so the card can keep the action row visible while the pointer is
    // over a button (the button's TouchArea otherwise steals hover from the
    // card's TouchArea, which would flicker the row out from under the cursor).
    out property <bool> hovered: ta.has-hover;
    callback clicked();

    property <color> fg: active_pin ? #2b1f00 : (active_float ? #0e2a17 : (danger && ta.has-hover ? #ffb0b0 : #f6f3ef));

    width: 26px;
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active_pin ? #c89a1a : (active_float ? #2faa55 : (danger && ta.has-hover ? #a84545 : #ffffff44));
    background: ta.pressed
        ? (active_pin ? #e0af1e : (active_float ? #37b863 : (danger ? #661c1cee : #454545ee)))
        : (active_pin
            ? #ffc832
            : (active_float ? #4cd47a : (danger && ta.has-hover ? #4a1616ee : (ta.has-hover ? #303030ee : #1b1b1bdd))));
    animate background { duration: 80ms; }

    Glyph {
        name: root.icon;
        paint: root.fg;
        size: 14px;
        weight: 1.7px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Snipdeck";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 700px;
    min-height: 500px;
    background: c-bg;

    // Rows of cards. Rust chunks the flat snip list into rows of `cols`
    // (reported via gallery-cols-changed) so the ListView below can
    // virtualize — only on-screen rows are ever instantiated.
    in property <[[SnipItem]]> rows: [];
    in property <image> checker-light;
    in property <image> checker-dark;
    in property <bool> dark-theme: true;
    in property <bool> any-floating: false;
    in property <bool> floating-in-taskbar: false;
    in-out property <string> search-text: "";
    in-out property <int> status-filter-index: 0;
    in-out property <int> content-filter-index: 0;
    in-out property <int> size-filter-index: 0;
    in-out property <int> date-filter-index: 0;
    in-out property <int> sort-index: 0;
    // Card/thumbnail size step: 0 = Small, 1 = Medium (default), 2 = Large.
    in-out property <int> thumb-size-index: 1;
    in property <string> error-text: "";
    in property <int> gallery-total: 0;
    in property <int> pinned-count: 0;
    in property <int> floating-count: 0;
    in property <int> filtered-count: 0;
    in property <string> storage-size: "0 KB";
    in property <[LangItem]> languages: [];
    in property <string> current-language: "en";
    in property <bool> autostart-enabled: false;
    property <bool> lang-open: false;

    // Card sizing for the gallery grid. `card-w` is the target card width per
    // size step; the thumbnail area scales with it while the text strip below
    // stays a fixed height. Derived values drive the row/card/thumb heights and
    // the cards-per-row formula so the whole grid reflows when the step changes.
    property <length> card-w: root.thumb-size-index == 0 ? 184px : (root.thumb-size-index == 2 ? 320px : 240px);
    property <length> thumb-h: root.card-w * 0.617;
    property <length> card-h: root.thumb-h + 72px;
    property <length> row-h: root.card-h + 10px;

    property <string> status-filter-value: status-filter-index == 1 ? @tr("Pinned") : (status-filter-index == 2 ? @tr("Unpinned") : (status-filter-index == 3 ? @tr("On screen") : (status-filter-index == 4 ? @tr("Hidden") : @tr("All"))));
    property <string> content-filter-value: content-filter-index == 1 ? @tr("Has OCR") : (content-filter-index == 2 ? @tr("No OCR") : (content-filter-index == 3 ? @tr("Has window") : (content-filter-index == 4 ? @tr("No window") : (content-filter-index == 5 ? @tr("Tagged") : @tr("All")))));
    property <string> size-filter-value: size-filter-index == 1 ? @tr("Small") : (size-filter-index == 2 ? @tr("Medium") : (size-filter-index == 3 ? @tr("Large") : (size-filter-index == 4 ? @tr("Wide") : (size-filter-index == 5 ? @tr("Tall") : (size-filter-index == 6 ? @tr("Square") : @tr("All"))))));
    property <string> date-filter-value: date-filter-index == 1 ? @tr("Today") : (date-filter-index == 2 ? @tr("24 hours") : (date-filter-index == 3 ? @tr("7 days") : (date-filter-index == 4 ? @tr("30 days") : @tr("All"))));
    property <string> sort-filter-value: sort-index == 1 ? @tr("Oldest") : (sort-index == 2 ? @tr("Pinned") : (sort-index == 3 ? @tr("Largest") : (sort-index == 4 ? @tr("Smallest") : (sort-index == 5 ? @tr("Width") : (sort-index == 6 ? @tr("Height") : (sort-index == 7 ? @tr("Monitor") : @tr("Newest")))))));
    property <bool> filters-active: search-text != "" || status-filter-index != 0 || content-filter-index != 0 || size-filter-index != 0 || date-filter-index != 0 || sort-index != 0;
    property <color> c-bg: dark-theme ? #141414 : #f3f1ec;
    property <color> c-toolbar: dark-theme ? #1f1f1f : #ffffff;
    property <color> c-filter: dark-theme ? #181818 : #f7f6f1;
    property <color> c-status: dark-theme ? #161616 : #ecebe5;
    property <color> c-divider: dark-theme ? #262626 : #e2dfd6;
    property <color> c-card: dark-theme ? #1c1c1c : #ffffff;
    property <color> c-card-hover: dark-theme ? #232323 : #fbfaf6;
    property <color> c-card-border: dark-theme ? #2a2a2a : #e2dfd6;
    property <color> c-card-border-hover: dark-theme ? #4a4a4a : #b8b3a6;
    property <color> c-well: dark-theme ? #0e0e0e : #101010;
    property <color> c-fg: dark-theme ? #e8e6e2 : #1a1816;
    property <color> c-fg2: dark-theme ? #b8b6b1 : #3a3631;
    property <color> c-fg3: dark-theme ? #8a8782 : #6e6962;
    property <color> c-fg4: dark-theme ? #5e5b56 : #9a948a;
    property <color> c-meta: dark-theme ? #7e9bbf : #3a5a8a;
    property <color> c-label: dark-theme ? #a8a29a : #5a544c;

    callback new-snip();
    callback new-snip-clip();
    callback new-snip-clip-only();
    callback collage-create();
    callback pick-color();
    callback toggle-all-visibility();
    callback toggle-floating-in-taskbar();
    callback clear-unpinned();
    callback clear-all();
    callback toggle-autostart();
    callback toggle-theme();
    callback show-about();
    callback set-language(string);
    callback snip-clicked(string);
    callback snip-context-menu(string);
    callback snip-copy(string);
    callback snip-save(string);
    callback snip-toggle-pin(string);
    callback snip-delete(string);
    callback search-changed(string);
    callback status-filter-changed(int);
    callback content-filter-changed(int);
    callback size-filter-changed(int);
    callback date-filter-changed(int);
    callback sort-changed(int);
    callback reset-filters();
    callback close-error();
    // A card requests its thumbnail when it scrolls into view (lazy load),
    // so decoded thumbnails never accumulate for the whole list.
    callback request-thumb(string);
    // Reports how many cards fit per row so Rust can re-chunk the list.
    callback gallery-cols-changed(int);
    // Reports the chosen card-size step (0/1/2) so Rust can persist it.
    callback thumb-size-changed(int);

    VerticalLayout {
        spacing: 0px;

        if root.error-text != "" : Rectangle {
            height: 30px;
            background: #4a1818;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 10px;
                alignment: center;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #e06363; }
                Text {
                    text: root.error-text;
                    color: #f3d0d0;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                ToolbarButton {
                    label: @tr("Close");
                    dark: root.dark-theme;
                    width: 62px;
                    clicked => { root.close-error(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #5a1f1f;
            }
        }

        Rectangle {
            height: 48px;
            background: root.c-toolbar;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 4px;
                alignment: center;

                ToolbarButton { icon: "plus"; label: @tr("New"); kbd: ""; primary: true; dark: root.dark-theme; tooltip: @tr("Take a new snip — drag a region with Win + left click"); width: 84px; clicked => { root.new-snip(); } }
                ToolbarButton { icon: "copy"; label: @tr("Snip + Clip"); dark: root.dark-theme; tooltip: @tr("Take a snip and copy it to the clipboard"); width: 112px; clicked => { root.new-snip-clip(); } }
                ToolbarButton { icon: "clipboard"; label: @tr("Clip only"); dark: root.dark-theme; tooltip: @tr("Copy to the clipboard only (without saving to the gallery)"); width: 98px; clicked => { root.new-snip-clip-only(); } }
                ToolbarButton { icon: "layers"; label: @tr("Collage"); dark: root.dark-theme; tooltip: @tr("Combine several snips into one collage"); width: 96px; clicked => { root.collage-create(); } }
                ToolbarButton { icon: "wand"; label: @tr("Pick color"); dark: root.dark-theme; tooltip: @tr("Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab"); width: 104px; clicked => { root.pick-color(); } }

                Rectangle { width: 1px; background: root.c-divider; }

                IconButton {
                    icon: root.any-floating ? "eye" : "eye-off";
                    dark: root.dark-theme;
                    active: root.any-floating;
                    tooltip: (root.any-floating ? @tr("Hide on-screen snips") : @tr("Show snips on screen")) + " (Win+Alt+H)";
                    clicked => { root.toggle-all-visibility(); }
                }
                IconButton {
                    icon: "window";
                    dark: root.dark-theme;
                    active: root.floating-in-taskbar;
                    tooltip: @tr("Show / hide floating snips in the taskbar");
                    clicked => { root.toggle-floating-in-taskbar(); }
                }

                Rectangle { horizontal-stretch: 1; }

                IconButton { icon: "pin-off"; dark: root.dark-theme; danger: true; tooltip: @tr("Clear unpinned snips"); clicked => { root.clear-unpinned(); } }
                IconButton { icon: "trash"; dark: root.dark-theme; danger: true; tooltip: @tr("Clear all snips"); clicked => { root.clear-all(); } }
                IconButton { icon: root.dark-theme ? "sun" : "moon"; dark: root.dark-theme; tooltip: @tr("Toggle light / dark theme"); clicked => { root.toggle-theme(); } }
                IconButton { icon: "globe"; dark: root.dark-theme; active: root.lang-open; tooltip: @tr("Language"); clicked => { root.lang-open = !root.lang-open; } }
                IconButton { icon: "power"; dark: root.dark-theme; active: root.autostart-enabled; tooltip: @tr("Launch at Login"); clicked => { root.toggle-autostart(); } }
                IconButton { icon: "info"; dark: root.dark-theme; tooltip: @tr("About Snipdeck"); clicked => { root.show-about(); } }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.c-divider;
            }
        }

        Rectangle {
            height: root.width < 760px ? 88px : (root.width < 1040px ? 84px : 47px);
            background: root.c-filter;

            if root.width >= 1040px : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: center;

                FilterPill {
                    label: @tr("Status");
                    value: root.status-filter-value;
                    dark: root.dark-theme;
                    active: root.status-filter-index != 0;
                    tooltip: @tr("Filter by status — All → Pinned → Unpinned → On screen → Hidden");
                    width: 124px;
                    clicked => {
                        root.status-filter-index = root.status-filter-index == 4 ? 0 : root.status-filter-index + 1;
                        root.status-filter-changed(root.status-filter-index);
                    }
                }
                FilterPill {
                    label: @tr("Content");
                    value: root.content-filter-value;
                    dark: root.dark-theme;
                    active: root.content-filter-index != 0;
                    tooltip: @tr("Filter by content — Has/No OCR · Has/No window · Tagged");
                    width: 146px;
                    clicked => {
                        root.content-filter-index = root.content-filter-index == 5 ? 0 : root.content-filter-index + 1;
                        root.content-filter-changed(root.content-filter-index);
                    }
                }
                FilterPill {
                    label: @tr("Size");
                    value: root.size-filter-value;
                    dark: root.dark-theme;
                    active: root.size-filter-index != 0;
                    tooltip: @tr("Filter by size — Small / Medium / Large / Wide / Tall / Square");
                    width: 132px;
                    clicked => {
                        root.size-filter-index = root.size-filter-index == 6 ? 0 : root.size-filter-index + 1;
                        root.size-filter-changed(root.size-filter-index);
                    }
                }
                FilterPill {
                    label: @tr("Date");
                    value: root.date-filter-value;
                    dark: root.dark-theme;
                    active: root.date-filter-index != 0;
                    tooltip: @tr("Filter by date — Today / 24 hours / 7 days / 30 days");
                    width: 132px;
                    clicked => {
                        root.date-filter-index = root.date-filter-index == 4 ? 0 : root.date-filter-index + 1;
                        root.date-filter-changed(root.date-filter-index);
                    }
                }
                FilterPill {
                    label: @tr("Sort");
                    value: root.sort-filter-value;
                    dark: root.dark-theme;
                    active: root.sort-index != 0;
                    tooltip: @tr("Sort by — Newest / Oldest / Pinned / Size / Width / Height / Monitor");
                    width: 144px;
                    clicked => {
                        root.sort-index = root.sort-index == 7 ? 0 : root.sort-index + 1;
                        root.sort-changed(root.sort-index);
                    }
                }
                SearchBox {
                    value <=> root.search-text;
                    dark: root.dark-theme;
                    edited(text) => { root.search-changed(text); }
                    cleared => { root.search-changed(""); }
                    horizontal-stretch: 1;
                    min-width: 220px;
                }
                SizeToggle {
                    dark: root.dark-theme;
                    current: root.thumb-size-index;
                    tooltip: @tr("Thumbnail size — Small / Medium / Large");
                    changed(i) => {
                        root.thumb-size-index = i;
                        root.thumb-size-changed(i);
                    }
                }
                ToolbarButton {
                    icon: "reset";
                    label: @tr("Reset");
                    dark: root.dark-theme;
                    active: root.filters-active;
                    tooltip: @tr("Reset all filters and search");
                    width: 84px;
                    clicked => { root.reset-filters(); }
                }
            }

            if root.width < 1040px : VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    FilterPill {
                        label: @tr("Status");
                        value: root.status-filter-value;
                        dark: root.dark-theme;
                        active: root.status-filter-index != 0;
                        tooltip: @tr("Filter by status — All → Pinned → Unpinned → On screen → Hidden");
                        width: 118px;
                        clicked => {
                            root.status-filter-index = root.status-filter-index == 4 ? 0 : root.status-filter-index + 1;
                            root.status-filter-changed(root.status-filter-index);
                        }
                    }
                    FilterPill {
                        label: @tr("Content");
                        value: root.content-filter-value;
                        dark: root.dark-theme;
                        active: root.content-filter-index != 0;
                        tooltip: @tr("Filter by content — Has/No OCR · Has/No window · Tagged");
                        horizontal-stretch: 1;
                        clicked => {
                            root.content-filter-index = root.content-filter-index == 5 ? 0 : root.content-filter-index + 1;
                            root.content-filter-changed(root.content-filter-index);
                        }
                    }
                    FilterPill {
                        label: @tr("Size");
                        value: root.size-filter-value;
                        dark: root.dark-theme;
                        active: root.size-filter-index != 0;
                        tooltip: @tr("Filter by size — Small / Medium / Large / Wide / Tall / Square");
                        width: 120px;
                        clicked => {
                            root.size-filter-index = root.size-filter-index == 6 ? 0 : root.size-filter-index + 1;
                            root.size-filter-changed(root.size-filter-index);
                        }
                    }
                    FilterPill {
                        label: @tr("Date");
                        value: root.date-filter-value;
                        dark: root.dark-theme;
                        active: root.date-filter-index != 0;
                        tooltip: @tr("Filter by date — Today / 24 hours / 7 days / 30 days");
                        width: 118px;
                        clicked => {
                            root.date-filter-index = root.date-filter-index == 4 ? 0 : root.date-filter-index + 1;
                            root.date-filter-changed(root.date-filter-index);
                        }
                    }
                    FilterPill {
                        label: @tr("Sort");
                        value: root.sort-filter-value;
                        dark: root.dark-theme;
                        active: root.sort-index != 0;
                        tooltip: @tr("Sort by — Newest / Oldest / Pinned / Size / Width / Height / Monitor");
                        width: 126px;
                        clicked => {
                            root.sort-index = root.sort-index == 7 ? 0 : root.sort-index + 1;
                            root.sort-changed(root.sort-index);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    SearchBox {
                        value <=> root.search-text;
                        dark: root.dark-theme;
                        edited(text) => { root.search-changed(text); }
                        cleared => { root.search-changed(""); }
                        horizontal-stretch: 1;
                    }
                    SizeToggle {
                        dark: root.dark-theme;
                        current: root.thumb-size-index;
                        tooltip: @tr("Thumbnail size — Small / Medium / Large");
                        changed(i) => {
                            root.thumb-size-index = i;
                            root.thumb-size-changed(i);
                        }
                    }
                    ToolbarButton {
                        icon: "reset";
                        label: @tr("Reset");
                        dark: root.dark-theme;
                        active: root.filters-active;
                        tooltip: @tr("Reset all filters and search");
                        width: 84px;
                        clicked => { root.reset-filters(); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.c-divider;
            }
        }

        if root.rows.length == 0 : Rectangle {
            background: root.c-bg;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 7px;
                Text {
                    text: @tr("No snips collected yet");
                    color: root.c-fg;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Capture a region from the screen with Win + left mouse.");
                    color: root.c-fg2;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("OCR, window info, and filters are indexed in the background.");
                    color: root.c-fg3;
                    horizontal-alignment: center;
                }
            }
        }

        if root.rows.length > 0 : grid := Rectangle {
            vertical-stretch: 1;

            // Cards-per-row, computed where the real width is known and
            // reported to Rust, which chunks the flat list into rows of this
            // many cards. The grid stays responsive while the ListView only
            // instantiates the rows actually on screen. Scales with the chosen
            // card width so S/M/L packs more or fewer cards per row.
            property <int> cols: max(1, Math.floor((self.width - 13px - 20px + 10px) / (root.card-w + 10px)));
            init => { root.gallery-cols-changed(self.cols); }
            changed cols => { root.gallery-cols-changed(self.cols); }

            lv := ListView {
                width: parent.width - 13px;
                height: parent.height;
                // Hide the widget's own scrollbar — we draw a more prominent
                // custom one (below) over the gutter.
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                for row[r] in root.rows : Rectangle {
                    height: root.row-h;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 10px;

                        for snip[c] in row : Rectangle {
                            // Full rows are justified: cards stretch to fill the
                            // whole width (no max cap) so there's no dead gutter
                            // on the right. A short last row keeps its cards at
                            // the natural `card-w` and the trailing spacer below
                            // soaks up the slack, leaving them left-packed. The
                            // min-width keeps a transient resize mismatch from
                            // squishing cards to nothing.
                            horizontal-stretch: 1;
                            min-width: root.card-w * 0.5;
                            max-width: row.length >= grid.cols ? 100000px : root.card-w;
                            height: root.card-h;
                            // Lazy-load the thumbnail once this card is realized.
                            init => { root.request-thumb(snip.id); }

                            background: card-touch.pressed ? (root.dark-theme ? #2e2e2e : #ebe9e2) : (card-touch.has-hover ? root.c-card-hover : root.c-card);
                            animate background { duration: 80ms; }
                border-color: snip.pinned && snip.floating
                    ? #5a5520
                    : (snip.floating
                        ? (card-touch.has-hover ? #3a7a4f : #2a5a3a)
                        : (snip.pinned
                            ? (card-touch.has-hover ? #6a5520 : #4a3a14)
                            : (card-touch.has-hover ? root.c-card-border-hover : root.c-card-border)));
                border-width: 1px;
                border-radius: 8px;
                clip: true;

                card-touch := TouchArea {
                    clicked => { root.snip-clicked(snip.id); }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.snip-context-menu(snip.id);
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: root.thumb-h;
                    background: root.dark-theme ? #181818 : #e7e3da;
                    clip: true;

                    // Checkerboard backdrop — a neutral, theme-aware ground so
                    // letterboxed snips read clearly instead of floating on flat black.
                    Image {
                        source: root.dark-theme ? root.checker-dark : root.checker-light;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }

                    // The snip drawn at its true aspect ratio as a floating
                    // "sheet" with a soft drop shadow, so it stands apart from
                    // the backdrop even when it doesn't fill the box.
                    Rectangle {
                        property <float> a: snip.aspect > 0 ? snip.aspect : 1.0;
                        property <float> well-a: parent.width / parent.height;
                        width: well-a > a ? parent.height * a : parent.width;
                        height: well-a > a ? parent.height : parent.width / a;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: root.dark-theme ? #0e0e0e : #ffffff;
                        drop-shadow-blur: 9px;
                        drop-shadow-color: #00000088;
                        drop-shadow-offset-y: 2px;
                        Image {
                            source: snip.thumb;
                            image-fit: fill;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    HorizontalLayout {
                        x: 6px;
                        y: 6px;
                        spacing: 4px;
                        if snip.pinned : Chip { text: @tr("pinned"); bg: #ffc832; fg: #2b1f00; chip-width: 50px; }
                        if snip.floating : Chip { text: @tr("on screen"); bg: #4cd47a; fg: #0e2a17; chip-width: 64px; }
                        if snip.has_ocr : Chip { text: "OCR"; bg: #15233a; fg: #6aa7ff; chip-width: 40px; }
                        if snip.has_window : Chip { text: "WIN"; bg: #251a3a; fg: #b48bff; chip-width: 38px; }
                    }

                    Rectangle {
                        x: parent.width - 88px;
                        y: 6px;
                        width: 82px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #00000088;
                        background: #000000bb;
                        Text {
                            text: snip.size_text;
                            color: #e0e0e0;
                            font-family: "Consolas";
                            font-size: 10px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                            overflow: elide;
                        }
                    }

                    // Always present (not `if`-gated) so a button never vanishes
                    // out from under the cursor. Shown while the card is hovered
                    // OR any action button is hovered — the row's gaps fall
                    // through to card-touch, so the OR never has a dead frame.
                    HorizontalLayout {
                        x: parent.width - 6px - 116px;
                        y: parent.height - 34px;
                        width: 116px;
                        height: 26px;
                        spacing: 4px;
                        visible: card-touch.has-hover || act-copy.hovered || act-save.hovered || act-pin.hovered || act-trash.hovered;
                        act-copy := CardAction { icon: "copy"; dark: root.dark-theme; clicked => { root.snip-copy(snip.id); } }
                        act-save := CardAction { icon: "save"; dark: root.dark-theme; clicked => { root.snip-save(snip.id); } }
                        act-pin := CardAction { icon: "pin"; dark: root.dark-theme; active_pin: snip.pinned; clicked => { root.snip-toggle-pin(snip.id); } }
                        act-trash := CardAction { icon: "trash"; dark: root.dark-theme; danger: true; clicked => { root.snip-delete(snip.id); } }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: root.c-divider;
                    }
                }

                Rectangle {
                    x: 0px;
                    y: root.thumb-h;
                    width: parent.width;
                    height: parent.height - root.thumb-h;
                    background: transparent;

                    VerticalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        padding-top: 7px;
                        padding-bottom: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: snip.dims;
                                color: root.c-fg;
                                font-family: "Consolas";
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: snip.created;
                                color: root.c-fg3;
                                font-family: "Consolas";
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: snip.source;
                            color: root.c-meta;
                            font-size: 11px;
                            overflow: elide;
                        }

                        if snip.preview != "" : HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                width: 30px;
                                height: 15px;
                                border-radius: 3px;
                                background: root.dark-theme ? #2a2520 : #fbe9d6;
                                Text {
                                    text: snip.preview_tag;
                                    color: root.dark-theme ? #ffb066 : #b85a14;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                            Text {
                                text: snip.preview;
                                color: root.c-label;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                    }

                        // Trailing flexible spacer soaks up leftover width so a
                        // short last row stays left-packed at the natural card
                        // size instead of stretching its few cards across the
                        // whole width. Full rows omit it so their cards justify
                        // edge-to-edge.
                        if row.length < grid.cols : Rectangle { horizontal-stretch: 1; }
                }
            }
            } // lv

            // Prominent custom scrollbar — a ListView shows no scroll
            // indicator of its own. Visible only when content overflows.
            if lv.viewport-height > lv.height + 1px : Rectangle {
                x: parent.width - 11px;
                y: 4px;
                width: 9px;
                height: parent.height - 8px;
                background: root.dark-theme ? #ffffff12 : #00000010;
                border-radius: 4px;

                sb-thumb := Rectangle {
                    width: parent.width;
                    height: max(40px, parent.height * (lv.height / max(1px, lv.viewport-height)));
                    y: (parent.height - self.height)
                        * (-lv.viewport-y / max(1px, lv.viewport-height - lv.height));
                    background: sb-ta.pressed
                        ? (root.dark-theme ? #dadada : #4e4e4e)
                        : (sb-ta.has-hover
                            ? (root.dark-theme ? #b8b8b8 : #6c6c6c)
                            : (root.dark-theme ? #8c8c8c : #9c9c9c));
                    border-radius: 4px;
                }

                sb-ta := TouchArea {
                    // Offset between the press point and the thumb's top, so
                    // grabbing the thumb scrolls it relative to where it was
                    // grabbed (no jump). A press on the bare track centres the
                    // thumb under the cursor instead.
                    property <length> grab: 0px;
                    function scroll-to(my: length) {
                        lv.viewport-y = -((my - self.grab) / max(1px, parent.height - sb-thumb.height))
                            * (lv.viewport-height - lv.height);
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            if (self.mouse-y >= sb-thumb.y && self.mouse-y <= sb-thumb.y + sb-thumb.height) {
                                self.grab = self.mouse-y - sb-thumb.y;
                            } else {
                                self.grab = sb-thumb.height / 2;
                            }
                            self.scroll-to(self.mouse-y);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.scroll-to(self.mouse-y);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: root.c-status;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                alignment: center;
                Text { text: "*"; color: #ff8a3d; font-size: 10px; vertical-alignment: center; }
                Text { text: @tr("Total {}", root.gallery-total); color: root.c-fg3; font-size: 11px; vertical-alignment: center; }
                Text { text: @tr("Pinned {}", root.pinned-count); color: root.c-fg3; font-size: 11px; vertical-alignment: center; }
                Text { text: @tr("On screen {}", root.floating-count); color: root.c-fg3; font-size: 11px; vertical-alignment: center; }
                Text { text: @tr("Filtered {}", root.filtered-count); color: root.c-fg3; font-size: 11px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.storage-size; color: root.c-fg3; font-size: 11px; vertical-alignment: center; }
                Rectangle { width: 1px; height: 14px; background: root.c-divider; }
                Text { text: @tr("Ctrl+F search"); color: root.c-fg4; font-family: "Consolas"; font-size: 10px; vertical-alignment: center; }
            }
            // Top divider between the gallery and the status bar. Anchored to
            // y:0 — without it Slint centres this 1px line vertically, so it cut
            // straight across the middle of the status text.
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1px;
                background: root.c-divider;
            }
        }
    }

    // Tooltip overlay — drawn last (on top of everything) from the Tips
    // singleton, clamped to stay inside the window's right edge.
    if Tips.text != "" : Rectangle {
        x: min(Tips.x, root.width - self.width - 6px);
        y: Tips.y;
        width: tip-label.preferred-width + 16px;
        height: 23px;
        border-radius: 5px;
        background: #2b2b2b;
        border-width: 1px;
        border-color: #00000077;
        tip-label := Text {
            text: Tips.text;
            color: #f0eeea;
            font-size: 11px;
            x: 8px;
            vertical-alignment: center;
            height: 100%;
        }
    }

    // Language menu — opens from the toolbar globe button. Drawn last so it
    // sits above the gallery; a full-window backdrop closes it on outside click.
    if root.lang-open : TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.lang-open = false; }
    }
    if root.lang-open : Rectangle {
        x: root.width - self.width - 16px;
        y: root.error-text != "" ? 80px : 50px;
        width: 210px;
        height: min(380px, root.languages.length * 28px + 8px);
        background: root.dark-theme ? #1f1f1f : #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.dark-theme ? #3a3a3a : #dcd9d1;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000077;
        drop-shadow-offset-y: 4px;
        ScrollView {
            width: 100%;
            height: 100%;
            VerticalLayout {
                padding: 4px;
                for l in root.languages : Rectangle {
                    height: 28px;
                    border-radius: 5px;
                    background: l.code == root.current-language
                        ? (root.dark-theme ? #2a2520 : #fbe9d6)
                        : (lang-row.pressed ? (root.dark-theme ? #333333 : #e6e5df) : (lang-row.has-hover ? (root.dark-theme ? #2a2a2a : #f0efe9) : transparent));
                    animate background { duration: 80ms; }
                    lang-row := TouchArea {
                        clicked => { root.set-language(l.code); root.lang-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 8px;
                        Text {
                            text: l.name;
                            color: l.code == root.current-language
                                ? (root.dark-theme ? #ffb066 : #b85a14)
                                : (root.dark-theme ? #e8e6e2 : #1a1816);
                            font-size: 12px;
                            font-weight: l.code == root.current-language ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: l.code;
                            color: root.dark-theme ? #6f6b64 : #9a948a;
                            font-size: 10px;
                            font-family: "Consolas";
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
