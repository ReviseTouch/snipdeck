import { FloatingWindow } from "floating.slint";
import { OverlayWindow } from "overlay.slint";
import { ContextMenuWindow } from "context_menu.slint";
import { TranslatePopupWindow, TransLang } from "translate_popup.slint";
import { AnnotateWindow, AnnoShape } from "annotate.slint";
import { CollageWindow, CollageCell, TrayItem } from "collage.slint";
import { AboutWindow } from "about.slint";
import { LoupeWindow } from "loupe.slint";
import { ColorResultWindow } from "color_result.slint";
import { UploadWindow } from "upload.slint";
import { Glyph } from "icons.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tips, ToolbarButton, SplitButton, IconButton, SearchBox, FilterChip, TextButton, SizeToggle, Badge, CardAction, Popover, MenuRow, MenuSeparator, Option } from "widgets.slint";

export { FloatingWindow, OverlayWindow, ContextMenuWindow, TranslatePopupWindow, TransLang, AnnotateWindow, AnnoShape, CollageWindow, CollageCell, TrayItem, AboutWindow, LoupeWindow, ColorResultWindow, UploadWindow }

export struct SnipItem {
    id: string,
    // The window the snip was taken from, when known; empty otherwise.
    title: string,
    dims: string,
    pinned: bool,
    floating: bool,
    has_ocr: bool,
    has_window: bool,
    monitor: string,
    created: string,
    thumb: image,
    aspect: float,
}

export struct LangItem {
    code: string,
    name: string,
}

export component MainWindow inherits Window {
    // Drop a showing tooltip. For a window hidden from code — a hotkey snip
    // taken while the pointer rested on a button — where no hover change ever
    // arrives, and the tip would greet the user when the window came back.
    public function clear-tip() {
        Tips.text = "";
    }

    title: "Snipdeck";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 480px;
    background: Theme.ground;

    init => {
        Theme.dark = root.dark-theme;
        root.narrow = root.width < 860px;
        keys.focus();
    }
    changed dark-theme => { Theme.dark = root.dark-theme; }

    // Rows of cards. Rust chunks the flat snip list into rows of `cols`
    // (reported via gallery-cols-changed) so the ListView below can
    // virtualize — only on-screen rows are ever instantiated.
    in property <[[SnipItem]]> rows: [];
    in property <image> checker-light;
    in property <image> checker-dark;
    in property <bool> dark-theme: true;
    in property <bool> any-floating: false;
    in property <bool> floating-in-taskbar: false;
    in-out property <string> search-text: "";
    in-out property <int> status-filter-index: 0;
    in-out property <int> content-filter-index: 0;
    in-out property <int> size-filter-index: 0;
    in-out property <int> date-filter-index: 0;
    in-out property <int> sort-index: 0;
    // Card/thumbnail size step: 0 = Small, 1 = Medium (default), 2 = Large.
    in-out property <int> thumb-size-index: 1;
    in property <string> error-text: "";
    in property <int> gallery-total: 0;
    in property <int> pinned-count: 0;
    in property <int> floating-count: 0;
    in property <int> filtered-count: 0;
    in property <string> storage-size: "0 KB";
    in property <[LangItem]> languages: [];
    // ⋯ → Upload to: catbox, Imgur, then the imported hosts (from 2).
    in property <[string]> upload-hosts: [];
    in property <int> upload-host-index: 0;
    callback pick-upload-host(int);
    callback add-upload-host();
    callback remove-upload-host();
    in property <string> current-language: "en";
    in property <bool> autostart-enabled: false;
    // How a snip is started here, for the hints that name it: 0 = Windows
    // (Win+drag), 1 = GNOME (Super+Alt+drag, through the shell extension),
    // 2 = anywhere else (the toolbar and the hotkeys; there is no drag gesture).
    in property <int> capture-gesture: 0;
    // The capture hotkeys as the user reads them ("Ctrl+Alt+Shift+A"), for
    // the New menu.
    in property <string> hotkey-snip: "";
    in property <string> hotkey-snip-clip: "";
    in property <string> hotkey-clip-only: "";
    property <bool> lang-open: false;
    property <bool> upload-open: false;
    property <bool> any-popover: new-menu-open || more-open || filter-open || sort-open || lang-open || upload-open;
    function close-popovers() {
        root.new-menu-open = false;
        root.more-open = false;
        root.filter-open = false;
        root.sort-open = false;
        root.lang-open = false;
        root.upload-open = false;
    }
    // Popovers: at most one is open at a time.
    property <bool> new-menu-open: false;
    property <bool> more-open: false;
    property <bool> filter-open: false;
    property <bool> sort-open: false;
    // How many of the four filters are set (sort and search are not filters).
    property <int> filter-count: (status-filter-index != 0 ? 1 : 0) + (content-filter-index != 0 ? 1 : 0)
        + (size-filter-index != 0 ? 1 : 0) + (date-filter-index != 0 ? 1 : 0);
    // Below this width the secondary toolbar buttons drop their labels. Set
    // from a change handler, not bound: the labels feed the toolbar's minimum
    // width, which feeds the window's, which feeds `width` — a binding here is
    // the layout asking about itself.
    property <bool> narrow: false;
    changed width => { root.narrow = root.width < 860px; }
    // Bulk-delete confirmation: 0 = closed, 1 = clear unpinned, 2 = clear all.
    // Both toolbar actions delete files permanently, and the trash button sits
    // right beside the theme toggle — one stray click used to empty the whole
    // gallery, pinned snips included.
    property <int> confirm-kind: 0;
    property <int> confirm-count: root.confirm-kind == 2 ? root.gallery-total : root.gallery-total - root.pinned-count;

    // Card sizing for the gallery grid. `card-w` is the target card width per
    // size step; the thumbnail area scales with it while the text strip below
    // stays a fixed height. Derived values drive the row/card/thumb heights and
    // the cards-per-row formula so the whole grid reflows when the step changes.
    property <length> card-w: root.thumb-size-index == 0 ? 184px : (root.thumb-size-index == 2 ? 320px : 240px);
    property <length> thumb-h: root.card-w * 0.617;
    property <length> card-h: root.thumb-h + 52px;
    property <length> row-h: root.card-h + 10px;

    property <string> status-filter-value: status-filter-index == 1 ? @tr("Pinned") : (status-filter-index == 2 ? @tr("Unpinned") : (status-filter-index == 3 ? @tr("On screen") : (status-filter-index == 4 ? @tr("Hidden") : @tr("All"))));
    property <string> content-filter-value: content-filter-index == 1 ? @tr("Has OCR") : (content-filter-index == 2 ? @tr("No OCR") : (content-filter-index == 3 ? @tr("Has window") : (content-filter-index == 4 ? @tr("No window") : @tr("All"))));
    property <string> size-filter-value: size-filter-index == 1 ? @tr("Small") : (size-filter-index == 2 ? @tr("Medium") : (size-filter-index == 3 ? @tr("Large") : (size-filter-index == 4 ? @tr("Wide") : (size-filter-index == 5 ? @tr("Tall") : (size-filter-index == 6 ? @tr("Square") : @tr("All"))))));
    property <string> date-filter-value: date-filter-index == 1 ? @tr("Today") : (date-filter-index == 2 ? @tr("24 hours") : (date-filter-index == 3 ? @tr("7 days") : (date-filter-index == 4 ? @tr("30 days") : @tr("All"))));
    property <string> sort-filter-value: sort-index == 1 ? @tr("Oldest") : (sort-index == 2 ? @tr("Pinned") : (sort-index == 3 ? @tr("Largest") : (sort-index == 4 ? @tr("Smallest") : (sort-index == 5 ? @tr("Width") : (sort-index == 6 ? @tr("Height") : (sort-index == 7 ? @tr("Monitor") : @tr("Newest")))))));
    property <bool> filters-active: search-text != "" || filter-count > 0 || sort-index != 0;
    // Older names for the theme's tokens, kept for the gallery's markup.
    property <color> c-bg: Theme.ground;
    property <color> c-divider: Theme.line;
    property <color> c-card: Theme.raised;
    property <color> c-card-border: Theme.line;
    property <color> c-card-border-hover: Theme.line-2;
    property <color> c-fg: Theme.ink-1;
    property <color> c-fg2: Theme.ink-2;
    property <color> c-fg3: Theme.ink-3;

    callback new-snip();
    callback new-snip-clip();
    callback new-snip-clip-only();
    callback collage-create();
    callback pick-color();
    callback toggle-all-visibility();
    callback toggle-floating-in-taskbar();
    callback clear-unpinned();
    callback clear-all();
    callback toggle-autostart();
    callback toggle-theme();
    callback show-about();
    callback set-language(string);
    callback snip-clicked(string);
    callback snip-context-menu(string);
    callback snip-copy(string);
    callback snip-save(string);
    callback snip-toggle-pin(string);
    callback snip-delete(string);
    callback search-changed(string);
    callback status-filter-changed(int);
    callback content-filter-changed(int);
    callback size-filter-changed(int);
    callback date-filter-changed(int);
    callback sort-changed(int);
    callback reset-filters();
    callback close-error();
    // A card requests its thumbnail when it scrolls into view (lazy load),
    // so decoded thumbnails never accumulate for the whole list.
    callback request-thumb(string);
    // Reports how many cards fit per row so Rust can re-chunk the list.
    callback gallery-cols-changed(int);
    // Reports the chosen card-size step (0/1/2) so Rust can persist it.
    callback thumb-size-changed(int);

    // Window-wide keys: Escape closes whatever popover is open; Ctrl+F goes
    // to search (the status bar used to advertise it with nothing behind it).
    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape && root.any-popover) {
                root.close-popovers();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                search.focus-input();
                return accept;
            }
            reject
        }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        if root.error-text != "" : Rectangle {
            height: 34px;
            background: Theme.danger-ground;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.danger; }
                }
                Text {
                    text: root.error-text;
                    color: Theme.ink-1;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Close");
                        clicked => { root.close-error(); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        // Toolbar — a panel: pinned to the window, no radius, one hairline.
        // Seven controls, every one of them at the toolbar's 28 px.
        Rectangle {
            height: 46px;
            background: Theme.panel;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    new-btn := SplitButton {
                        icon: "plus";
                        label: @tr("New");
                        menu-open: root.new-menu-open;
                        tooltip: root.capture-gesture == 0 ? @tr("Take a new snip — drag a region with Win + left click")
                            : root.capture-gesture == 1 ? @tr("Take a new snip — or drag a region with Super + Alt")
                            : @tr("Take a new snip");
                        clicked => { root.new-snip(); }
                        menu => { root.new-menu-open = !root.new-menu-open; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ToolbarButton {
                        icon: "layers";
                        label: @tr("Collage");
                        compact: root.narrow;
                        tooltip: @tr("Combine several snips into one collage");
                        clicked => { root.collage-create(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ToolbarButton {
                        icon: "wand";
                        label: @tr("Pick color");
                        compact: root.narrow;
                        tooltip: @tr("Pick a color from anywhere on screen — a magnifier follows the cursor, click to grab");
                        clicked => { root.pick-color(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    search := SearchBox {
                        value <=> root.search-text;
                        placeholder: @tr("text / OCR / window / monitor / path");
                        min-width: 160px;
                        edited(text) => { root.search-changed(text); }
                        cleared => { root.search-changed(""); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    filter-btn := ToolbarButton {
                        icon: "sliders";
                        label: root.filter-count > 0 ? @tr("Filter") + " · " + root.filter-count : @tr("Filter");
                        active: root.filter-open || root.filter-count > 0;
                        compact: root.narrow && root.filter-count == 0;
                        clicked => { root.filter-open = !root.filter-open; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    IconButton {
                        icon: root.any-floating ? "eye" : "eye-off";
                        active: root.any-floating;
                        tooltip: (root.any-floating ? @tr("Hide on-screen snips") : @tr("Show snips on screen")) + (root.capture-gesture == 0 ? " (Win+Alt+H)" : " (Super+Alt+H)");
                        clicked => { root.toggle-all-visibility(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    more-btn := IconButton {
                        icon: "more";
                        active: root.more-open;
                        tooltip: @tr("More");
                        clicked => { root.more-open = !root.more-open; }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        // Active filters — part of the panel, shown only while there are any.
        if root.filter-count > 0 : Rectangle {
            height: 34px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: start;
                if root.status-filter-index != 0 : VerticalLayout {
                    alignment: center;
                    FilterChip { text: root.status-filter-value; removed => { root.status-filter-index = 0; root.status-filter-changed(0); } }
                }
                if root.content-filter-index != 0 : VerticalLayout {
                    alignment: center;
                    FilterChip { text: root.content-filter-value; removed => { root.content-filter-index = 0; root.content-filter-changed(0); } }
                }
                if root.size-filter-index != 0 : VerticalLayout {
                    alignment: center;
                    FilterChip { text: root.size-filter-value; removed => { root.size-filter-index = 0; root.size-filter-changed(0); } }
                }
                if root.date-filter-index != 0 : VerticalLayout {
                    alignment: center;
                    FilterChip { text: root.date-filter-value; removed => { root.date-filter-index = 0; root.date-filter-changed(0); } }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: @tr("Clear filters");
                        clicked => {
                            root.status-filter-index = 0;
                            root.content-filter-index = 0;
                            root.size-filter-index = 0;
                            root.date-filter-index = 0;
                            root.status-filter-changed(0);
                            root.content-filter-changed(0);
                            root.size-filter-changed(0);
                            root.date-filter-changed(0);
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
        }

        if root.rows.length == 0 : Rectangle {
            background: root.c-bg;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                spacing: 7px;
                Text {
                    text: @tr("No snips collected yet");
                    color: root.c-fg;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.capture-gesture == 0 ? @tr("Capture a region from the screen with Win + left mouse.")
                        : root.capture-gesture == 1 ? @tr("Capture a region from the screen with Super + Alt + drag.")
                        : @tr("Capture a region from the screen with the New button or a hotkey.");
                    color: root.c-fg2;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("OCR, window info, and filters are indexed in the background.");
                    color: root.c-fg3;
                    horizontal-alignment: center;
                }
            }
        }

        if root.rows.length > 0 : grid := Rectangle {
            vertical-stretch: 1;

            // Cards-per-row, computed where the real width is known and
            // reported to Rust, which chunks the flat list into rows of this
            // many cards. The grid stays responsive while the ListView only
            // instantiates the rows actually on screen. Scales with the chosen
            // card width so S/M/L packs more or fewer cards per row.
            property <int> cols: max(1, Math.floor((self.width - 13px - 20px + 10px) / (root.card-w + 10px)));
            init => { root.gallery-cols-changed(self.cols); }
            changed cols => { root.gallery-cols-changed(self.cols); }

            lv := ListView {
                width: parent.width - 13px;
                height: parent.height;
                // Hide the widget's own scrollbar — we draw a more prominent
                // custom one (below) over the gutter.
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                for row[r] in root.rows : Rectangle {
                    height: root.row-h;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 10px;

                        for snip[c] in row : Rectangle {
                            // Full rows are justified: cards stretch to fill the
                            // whole width (no max cap) so there's no dead gutter
                            // on the right. A short last row keeps its cards at
                            // the natural `card-w` and the trailing spacer below
                            // soaks up the slack, leaving them left-packed. The
                            // min-width keeps a transient resize mismatch from
                            // squishing cards to nothing.
                            horizontal-stretch: 1;
                            min-width: root.card-w * 0.5;
                            max-width: row.length >= grid.cols ? 100000px : root.card-w;
                            height: root.card-h;
                            // Lazy-load the thumbnail once this card is realized.
                            init => { root.request-thumb(snip.id); }

                            // An island: raised, edged, 9 px. Hover darkens the
                            // edge, not the card — the signal is in the line.
                            background: Theme.raised;
                border-color: card-touch.has-hover ? Theme.line-strong : Theme.line;
                border-width: 1px;
                border-radius: 9px;
                clip: true;

                card-touch := TouchArea {
                    clicked => { root.snip-clicked(snip.id); }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                            root.snip-context-menu(snip.id);
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: root.thumb-h;
                    background: Theme.fill;
                    clip: true;

                    // Checkerboard backdrop — a neutral, theme-aware ground so
                    // letterboxed snips read clearly instead of floating on flat black.
                    Image {
                        source: root.dark-theme ? root.checker-dark : root.checker-light;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }

                    // The snip at its true aspect ratio as a "sheet" with a
                    // soft shadow, so it stands apart from the backdrop.
                    Rectangle {
                        property <float> a: snip.aspect > 0 ? snip.aspect : 1.0;
                        property <float> well-a: parent.width / parent.height;
                        width: well-a > a ? parent.height * a : parent.width;
                        height: well-a > a ? parent.height : parent.width / a;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: Theme.raised;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000055;
                        drop-shadow-offset-y: 2px;
                        Image {
                            source: snip.thumb;
                            image-fit: fill;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // Status, neutral: what the snip is, not a rainbow of it.
                    HorizontalLayout {
                        x: 6px;
                        y: 6px;
                        width: self.preferred-width;
                        height: 18px;
                        spacing: 4px;
                        if snip.pinned : Badge { text: @tr("pinned"); }
                        if snip.floating : Badge { text: @tr("on screen"); }
                        if snip.has_ocr : Badge { text: "OCR"; }
                    }

                    // Always present (not `if`-gated) so a button never vanishes
                    // out from under the cursor. Shown while the card is hovered
                    // OR any action button is hovered — the row's gaps fall
                    // through to card-touch, so the OR never has a dead frame.
                    HorizontalLayout {
                        x: parent.width - 6px - 116px;
                        y: parent.height - 32px;
                        width: 116px;
                        height: 26px;
                        spacing: 4px;
                        visible: card-touch.has-hover || act-copy.hovered || act-save.hovered || act-pin.hovered || act-trash.hovered;
                        act-copy := CardAction { icon: "copy"; clicked => { root.snip-copy(snip.id); } }
                        act-save := CardAction { icon: "save"; clicked => { root.snip-save(snip.id); } }
                        act-pin := CardAction { icon: "pin"; active: snip.pinned; clicked => { root.snip-toggle-pin(snip.id); } }
                        act-trash := CardAction { icon: "trash"; danger: true; clicked => { root.snip-delete(snip.id); } }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                // Two lines: what it is (the window it came from, or when),
                // and where — time, monitor, and the size, once, as data.
                VerticalLayout {
                    x: 0px;
                    y: root.thumb-h;
                    width: parent.width;
                    height: parent.height - root.thumb-h;
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: snip.title != "" ? snip.title : snip.created;
                        color: Theme.ink-1;
                        font-size: 13.5px;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: snip.title != "" ? snip.created + " · " + snip.monitor : snip.monitor;
                            color: Theme.ink-3;
                            font-size: 12.5px;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: snip.dims;
                            color: Theme.ink-3;
                            font-family: "monospace";
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
                    }

                        // Trailing flexible spacer soaks up leftover width so a
                        // short last row stays left-packed at the natural card
                        // size instead of stretching its few cards across the
                        // whole width. Full rows omit it so their cards justify
                        // edge-to-edge.
                        if row.length < grid.cols : Rectangle { horizontal-stretch: 1; }
                }
            }
            } // lv

            // Prominent custom scrollbar — a ListView shows no scroll
            // indicator of its own. Visible only when content overflows.
            if lv.viewport-height > lv.height + 1px : Rectangle {
                x: parent.width - 11px;
                y: 4px;
                width: 9px;
                height: parent.height - 8px;
                background: Theme.fill;
                border-radius: 4px;

                sb-thumb := Rectangle {
                    width: parent.width;
                    height: max(40px, parent.height * (lv.height / max(1px, lv.viewport-height)));
                    y: (parent.height - self.height)
                        * (-lv.viewport-y / max(1px, lv.viewport-height - lv.height));
                    background: sb-ta.pressed ? Theme.ink-3 : (sb-ta.has-hover ? Theme.line-strong : Theme.island);
                    border-radius: 4px;
                }

                sb-ta := TouchArea {
                    // Offset between the press point and the thumb's top, so
                    // grabbing the thumb scrolls it relative to where it was
                    // grabbed (no jump). A press on the bare track centres the
                    // thumb under the cursor instead.
                    property <length> grab: 0px;
                    function scroll-to(my: length) {
                        lv.viewport-y = -((my - self.grab) / max(1px, parent.height - sb-thumb.height))
                            * (lv.viewport-height - lv.height);
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            if (self.mouse-y >= sb-thumb.y && self.mouse-y <= sb-thumb.y + sb-thumb.height) {
                                self.grab = self.mouse-y - sb-thumb.y;
                            } else {
                                self.grab = sb-thumb.height / 2;
                            }
                            self.scroll-to(self.mouse-y);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            self.scroll-to(self.mouse-y);
                        }
                    }
                }
            }
        }

        // Status bar — a panel. Counts on the left; how the gallery is shown
        // (order, card size) on the right, where they no longer crowd the
        // toolbar.
        Rectangle {
            height: 33px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 12px;
                Text {
                    text: @tr("Total {}", root.gallery-total) + "  ·  " + @tr("Pinned {}", root.pinned-count) + "  ·  " + @tr("On screen {}", root.floating-count)
                        + (root.filters-active ? "  ·  " + @tr("Filtered {}", root.filtered-count) : "")
                        + "  ·  " + root.storage-size;
                    color: Theme.ink-3;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    sort-btn := TextButton {
                        text: @tr("Sort") + ":";
                        value: root.sort-filter-value;
                        chevron: true;
                        open: root.sort-open;
                        clicked => { root.sort-open = !root.sort-open; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    SizeToggle {
                        current: root.thumb-size-index;
                        tooltip: @tr("Thumbnail size — Small / Medium / Large");
                        changed(i) => {
                            root.thumb-size-index = i;
                            root.thumb-size-changed(i);
                        }
                    }
                }
            }
            // Hairline against the gallery, pinned to the top — unanchored, a
            // 1px child is centred and cuts across the text.
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
        }
    }
    } // keys

    // Tooltip — an island: raised, edged, drawn last over everything and
    // clamped inside the window's right edge.
    if Tips.text != "" : Rectangle {
        x: min(Tips.x, root.width - self.width - 6px);
        y: Tips.y;
        width: tip-label.preferred-width + 16px;
        height: 24px;
        border-radius: 7px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.island;
        tip-label := Text {
            text: Tips.text;
            color: Theme.ink-1;
            font-size: 12.5px;
            x: 8px;
            vertical-alignment: center;
            height: 100%;
        }
    }

    // One backdrop for every popover: a click outside closes it.
    if root.any-popover : TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.close-popovers(); }
    }

    // New ▾ — the capture variants, with their hotkeys.
    if root.new-menu-open : Popover {
        x: new-btn.absolute-position.x;
        y: new-btn.absolute-position.y + new-btn.height + 6px;
        width: 300px;
        height: new-menu.preferred-height;
        new-menu := VerticalLayout {
            padding: 4px;
            MenuRow { text: @tr("Take a new snip"); shortcut: root.hotkey-snip; clicked => { root.close-popovers(); root.new-snip(); } }
            MenuRow { text: @tr("Snip + Clip"); shortcut: root.hotkey-snip-clip; clicked => { root.close-popovers(); root.new-snip-clip(); } }
            MenuRow { text: @tr("Clip only"); shortcut: root.hotkey-clip-only; clicked => { root.close-popovers(); root.new-snip-clip-only(); } }
        }
    }

    // ⋯ — settings that are set once, the destructive clean-ups, About.
    if root.more-open : Popover {
        x: more-btn.absolute-position.x + more-btn.width - self.width;
        y: more-btn.absolute-position.y + more-btn.height + 6px;
        width: 280px;
        height: more-menu.preferred-height;
        more-menu := VerticalLayout {
            padding: 4px;
            MenuRow {
                text: @tr("Floating snips in the taskbar");
                checkable: true;
                checked: root.floating-in-taskbar;
                clicked => { root.toggle-floating-in-taskbar(); }
            }
            MenuRow {
                text: @tr("Dark theme");
                checkable: true;
                checked: root.dark-theme;
                clicked => { root.toggle-theme(); }
            }
            MenuRow {
                text: @tr("Launch at Login");
                checkable: true;
                checked: root.autostart-enabled;
                clicked => { root.toggle-autostart(); }
            }
            MenuRow {
                text: @tr("Language");
                checkable: true;
                submenu: true;
                clicked => { root.more-open = false; root.lang-open = true; }
            }
            MenuRow {
                text: @tr("Upload to");
                checkable: true;
                submenu: true;
                clicked => { root.more-open = false; root.upload-open = true; }
            }
            MenuSeparator { }
            MenuRow {
                text: @tr("Clear unpinned snips");
                danger: true;
                clicked => {
                    root.close-popovers();
                    if (root.gallery-total - root.pinned-count > 0) { root.confirm-kind = 1; }
                }
            }
            MenuRow {
                text: @tr("Clear all snips");
                danger: true;
                clicked => {
                    root.close-popovers();
                    if (root.gallery-total > 0) { root.confirm-kind = 2; }
                }
            }
            MenuSeparator { }
            MenuRow {
                text: @tr("About Snipdeck");
                checkable: true;
                clicked => { root.close-popovers(); root.show-about(); }
            }
        }
    }

    // Language — opened from ⋯, in the same place.
    if root.lang-open : Popover {
        x: more-btn.absolute-position.x + more-btn.width - self.width;
        y: more-btn.absolute-position.y + more-btn.height + 6px;
        width: 240px;
        height: min(root.height - self.y - 16px, root.languages.length * 32px + 8px);
        ScrollView {
            width: 100%;
            height: 100%;
            VerticalLayout {
                padding: 4px;
                for l in root.languages : MenuRow {
                    text: l.name;
                    shortcut: l.code;
                    checkable: true;
                    checked: l.code == root.current-language;
                    clicked => { root.set-language(l.code); root.lang-open = false; }
                }
            }
        }
    }

    // Upload to — opened from ⋯, in the same place. Where "Upload" sends a
    // snip; the upload window names it again before anything is sent.
    if root.upload-open : Popover {
        x: more-btn.absolute-position.x + more-btn.width - self.width;
        y: more-btn.absolute-position.y + more-btn.height + 6px;
        width: 280px;
        height: min(root.height - self.y - 16px, upload-menu.preferred-height);
        ScrollView {
            width: 100%;
            height: 100%;
            upload-menu := VerticalLayout {
                padding: 4px;
                for name[i] in root.upload-hosts : MenuRow {
                    text: name;
                    checkable: true;
                    checked: i == root.upload-host-index;
                    clicked => { root.pick-upload-host(i); }
                }
                MenuSeparator { }
                MenuRow {
                    text: @tr("Add from a .sxcu file…");
                    checkable: true;
                    clicked => { root.close-popovers(); root.add-upload-host(); }
                }
                if root.upload-host-index >= 2 : MenuRow {
                    text: @tr("Remove this host");
                    checkable: true;
                    danger: true;
                    clicked => { root.close-popovers(); root.remove-upload-host(); }
                }
            }
        }
    }

    // Filter — the four filters, each as direct choices. Stays open while
    // choosing; the strip under the toolbar shows what is set.
    if root.filter-open : Popover {
        x: max(8px, filter-btn.absolute-position.x + filter-btn.width - self.width);
        y: filter-btn.absolute-position.y + filter-btn.height + 6px;
        width: 380px;
        height: filter-panel.preferred-height;
        filter-panel := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Text { text: @tr("Status"); color: Theme.ink-3; font-size: 12.5px; height: 20px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("All"); selected: root.status-filter-index == 0; clicked => { root.status-filter-index = 0; root.status-filter-changed(0); } }
                Option { text: @tr("Pinned"); selected: root.status-filter-index == 1; clicked => { root.status-filter-index = 1; root.status-filter-changed(1); } }
                Option { text: @tr("Unpinned"); selected: root.status-filter-index == 2; clicked => { root.status-filter-index = 2; root.status-filter-changed(2); } }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("On screen"); selected: root.status-filter-index == 3; clicked => { root.status-filter-index = 3; root.status-filter-changed(3); } }
                Option { text: @tr("Hidden"); selected: root.status-filter-index == 4; clicked => { root.status-filter-index = 4; root.status-filter-changed(4); } }
            }
            Rectangle { height: 6px; }
            Text { text: @tr("Content"); color: Theme.ink-3; font-size: 12.5px; height: 20px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("All"); selected: root.content-filter-index == 0; clicked => { root.content-filter-index = 0; root.content-filter-changed(0); } }
                Option { text: @tr("Has OCR"); selected: root.content-filter-index == 1; clicked => { root.content-filter-index = 1; root.content-filter-changed(1); } }
                Option { text: @tr("No OCR"); selected: root.content-filter-index == 2; clicked => { root.content-filter-index = 2; root.content-filter-changed(2); } }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("Has window"); selected: root.content-filter-index == 3; clicked => { root.content-filter-index = 3; root.content-filter-changed(3); } }
                Option { text: @tr("No window"); selected: root.content-filter-index == 4; clicked => { root.content-filter-index = 4; root.content-filter-changed(4); } }
            }
            Rectangle { height: 6px; }
            Text { text: @tr("Size"); color: Theme.ink-3; font-size: 12.5px; height: 20px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("All"); selected: root.size-filter-index == 0; clicked => { root.size-filter-index = 0; root.size-filter-changed(0); } }
                Option { text: @tr("Small"); selected: root.size-filter-index == 1; clicked => { root.size-filter-index = 1; root.size-filter-changed(1); } }
                Option { text: @tr("Medium"); selected: root.size-filter-index == 2; clicked => { root.size-filter-index = 2; root.size-filter-changed(2); } }
                Option { text: @tr("Large"); selected: root.size-filter-index == 3; clicked => { root.size-filter-index = 3; root.size-filter-changed(3); } }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("Wide"); selected: root.size-filter-index == 4; clicked => { root.size-filter-index = 4; root.size-filter-changed(4); } }
                Option { text: @tr("Tall"); selected: root.size-filter-index == 5; clicked => { root.size-filter-index = 5; root.size-filter-changed(5); } }
                Option { text: @tr("Square"); selected: root.size-filter-index == 6; clicked => { root.size-filter-index = 6; root.size-filter-changed(6); } }
            }
            Rectangle { height: 6px; }
            Text { text: @tr("Date"); color: Theme.ink-3; font-size: 12.5px; height: 20px; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("All"); selected: root.date-filter-index == 0; clicked => { root.date-filter-index = 0; root.date-filter-changed(0); } }
                Option { text: @tr("Today"); selected: root.date-filter-index == 1; clicked => { root.date-filter-index = 1; root.date-filter-changed(1); } }
                Option { text: @tr("24 hours"); selected: root.date-filter-index == 2; clicked => { root.date-filter-index = 2; root.date-filter-changed(2); } }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Option { text: @tr("7 days"); selected: root.date-filter-index == 3; clicked => { root.date-filter-index = 3; root.date-filter-changed(3); } }
                Option { text: @tr("30 days"); selected: root.date-filter-index == 4; clicked => { root.date-filter-index = 4; root.date-filter-changed(4); } }
            }
        }
    }

    // Sort — opens upward from the status bar.
    if root.sort-open : Popover {
        x: sort-btn.absolute-position.x + sort-btn.width - self.width;
        y: sort-btn.absolute-position.y - self.height - 6px;
        width: 220px;
        height: sort-menu.preferred-height;
        sort-menu := VerticalLayout {
            padding: 4px;
            for opt[i] in [@tr("Newest"), @tr("Oldest"), @tr("Pinned"), @tr("Largest"), @tr("Smallest"), @tr("Width"), @tr("Height"), @tr("Monitor")] : MenuRow {
                text: opt;
                checkable: true;
                checked: root.sort-index == i;
                clicked => { root.sort-index = i; root.sort-changed(i); root.sort-open = false; }
            }
        }
    }

    // Bulk-delete confirmation. A backdrop click, Cancel or Esc backs out;
    // only the explicit Delete button goes through.
    if root.confirm-kind != 0 : Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.confirm-kind = 0; }
        }
        confirm-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.confirm-kind = 0;
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: 168px;
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.island;
            drop-shadow-blur: 64px;
            drop-shadow-color: Theme.shadow-modal;
            drop-shadow-offset-y: 22px;
            // Swallow clicks on the card itself, so only the backdrop cancels.
            TouchArea {
                width: 100%;
                height: 100%;
            }
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text {
                    text: root.confirm-kind == 2
                        ? @tr("Delete all {} snips?", root.confirm-count)
                        : @tr("Delete {} unpinned snips?", root.confirm-count);
                    color: Theme.ink-1;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: root.confirm-kind == 2
                        ? @tr("Every snip goes, pinned ones included. The images are deleted from disk and cannot be restored.")
                        : @tr("Pinned snips stay. The images are deleted from disk and cannot be restored.");
                    color: Theme.ink-2;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    ToolbarButton {
                        label: @tr("Cancel");
                        clicked => { root.confirm-kind = 0; }
                    }
                    ToolbarButton {
                        label: @tr("Delete");
                        destructive: true;
                        clicked => {
                            if (root.confirm-kind == 2) {
                                root.clear-all();
                            } else {
                                root.clear-unpinned();
                            }
                            root.confirm-kind = 0;
                        }
                    }
                }
            }
        }
    }
}
