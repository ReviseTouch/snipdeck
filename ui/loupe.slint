// Magnifier loupe for the colour-picker tool. A small always-on-top window
// that follows the cursor; Rust pushes the magnified screen region around the
// cursor plus the centre pixel's colour every tick. Click captures, Esc cancels
// (both handled by the mouse/keyboard hook, not here).

export component LoupeWindow inherits Window {
    title: "SnipdeckLoupe";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // Pre-magnified region (Rust upscales nearest-neighbour so pixels stay crisp).
    in property <image> zoom;
    in property <string> hex: "#000000";
    in property <color> swatch: #000000;

    width: 168px;
    height: 196px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #1c1c1c;
        border-radius: 10px;
        border-width: 1px;
        border-color: #3a3a3a;

        VerticalLayout {
            padding: 6px;
            spacing: 6px;

            // Magnified pixels.
            Rectangle {
                width: 156px;
                height: 156px;
                border-radius: 4px;
                clip: true;
                border-width: 1px;
                border-color: #2a2a2a;

                Image {
                    source: root.zoom;
                    image-fit: fill;
                    width: 100%;
                    height: 100%;
                }
                // Centre-pixel marker: a dark ring under a white ring so it
                // reads on both light and dark pixels.
                Rectangle {
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: transparent;
                    border-width: 1px;
                    border-color: #000000;
                }
                Rectangle {
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: transparent;
                    border-width: 1.5px;
                    border-color: #ffffff;
                }
            }

            // Colour swatch + hex readout.
            HorizontalLayout {
                height: 22px;
                spacing: 6px;
                Rectangle {
                    width: 22px;
                    border-radius: 3px;
                    background: root.swatch;
                    border-width: 1px;
                    border-color: #00000088;
                }
                Text {
                    text: root.hex;
                    color: #e8e6e2;
                    font-size: 13px;
                    font-family: "Consolas";
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
