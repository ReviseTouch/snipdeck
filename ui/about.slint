// About window — app info + a brand-level "Made by ReviseTouch" funnel.
//
// Opened from the toolbar's info button. Three SEPARATE links (per the product
// owner): ReviseTouch (revisetouch.com — where the app is published / its home),
// GitHub (the open-source repo), and an optional Support button. The Support
// button only appears when `has-donate` is true; Rust sets that from a
// build-time env var (`option_env!("SNIPDECK_DONATE_URL")`) so the donation link
// lives ONLY in the shipped binary, never in the public source.

import { Glyph } from "icons.slint";

// A small pill link/button.
component LinkButton inherits Rectangle {
    in property <string> label;
    in property <bool> accent;
    callback clicked();
    height: 34px;
    min-width: 96px;
    border-radius: 17px;
    background: root.accent
        ? (ta.has-hover ? #2a93ff : #0a84ff)
        : (ta.has-hover ? #303033 : #232326);
    Text {
        text: root.label;
        color: root.accent ? #ffffff : #e8e6e2;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AboutWindow inherits Window {
    title: @tr("About Snipdeck");
    background: #0d0d0f;
    icon: @image-url("../assets/preview_256.png");
    always-on-top: true;

    in property <string> version: "0.1.0";
    in property <bool> has-donate: false;

    callback open-revisetouch();
    callback open-github();
    callback open-donate();
    callback close();

    forward-focus: key-catcher;

    Rectangle {
        background: #0d0d0f;
        VerticalLayout {
            padding: 26px;
            spacing: 14px;

            // App identity.
            HorizontalLayout {
                spacing: 16px;
                Image {
                    source: @image-url("../assets/preview_256.png");
                    width: 56px;
                    height: 56px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Snipdeck";
                        color: #f2f0ea;
                        font-size: 24px;
                        font-weight: 800;
                    }
                    Text {
                        text: @tr("Version") + " " + root.version;
                        color: #8a8a8e;
                        font-size: 12px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            Text {
                text: @tr("A fast, free, open-source screen-snipping deck for Windows.");
                color: #c4c1ba;
                font-size: 13px;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: #ffffff18; }

            // Brand funnel.
            Text {
                text: @tr("Made by ReviseTouch — we build developer tools & AI products.");
                color: #c4c1ba;
                font-size: 13px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                LinkButton {
                    label: @tr("Visit ReviseTouch");
                    accent: true;
                    clicked => { root.open-revisetouch(); }
                }
                LinkButton {
                    label: "GitHub";
                    clicked => { root.open-github(); }
                }
                if root.has-donate : LinkButton {
                    label: @tr("Support");
                    clicked => { root.open-donate(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Footer.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "MIT License · © 2026 Hasan Salihoğlu";
                    color: #6a6a6e;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                LinkButton {
                    label: @tr("Close");
                    clicked => { root.close(); }
                }
            }
        }
    }

    key-catcher := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.close(); return accept; }
            return reject;
        }
    }
}
