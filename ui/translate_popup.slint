// OCR + Translate result popup.
//
// One borderless, always-on-top window shown after the user picks
// "OCR + Translate" on a floating snip. Rust runs OCR then translation on a
// worker thread and pushes the strings in. The language strip (plus a "More"
// dropdown with the full list) switches the target language inline — Rust
// re-translates on the fly and remembers the choice across sessions. The
// window can be dragged by its title bar and resized from the bottom-right
// grip (both mutate properties bound to the OS window, same trick the floating
// snips use).

import { Glyph } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// One language entry shared between Rust and the popup. `short` is the compact
// pill label (e.g. "ZH" for "zh-CN"); `fav` marks it as a quick-pick pill.
export struct TransLang {
    code: string,
    label: string,
    short: string,
    fav: bool,
}

// Compact language pill. Shows the short code (TR, EN …); the active one is
// highlighted in the brand orange.
component TransLangBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? #d96a1f : (ta.has-hover ? #3a3a3a : #2a2a2a);
    background: active ? #2a1d12 : (ta.pressed ? #2e2e2e : (ta.has-hover ? #242424 : transparent));
    animate background { duration: 80ms; }

    Text {
        text: root.label;
        color: active ? #ffb066 : (ta.has-hover ? #e8e6e2 : #b8b6b1);
        font-size: 11px;
        font-weight: active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TranslatePopupWindow inherits Window {
    title: "SnipdeckTranslate";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    // Window size, bound to the OS window so mutating them resizes it live.
    in-out property <length> win-w: 380px;
    in-out property <length> win-h: 392px;
    width: win-w;
    height: win-h;

    // True while OCR/translation is in flight — shows a "translating…" state.
    in-out property <bool> loading: false;
    in-out property <string> error-text: "";
    in-out property <string> source-text: "";
    in-out property <string> translated-text: "";
    // Friendly label of the auto-detected source language (set by Rust).
    in-out property <string> detected-lang: "";
    // Active target language *code* (drives pill highlight) + its friendly
    // label (shown in the header), both set by Rust.
    in-out property <string> target-lang: "en";
    in-out property <string> target-label: "English";

    // Quick-pick pills (the favourites) and the full "More" list — both
    // supplied and kept in sync by Rust.
    in property <[TransLang]> favs;
    in property <[TransLang]> all-langs;

    callback pick-lang(string);
    callback copy();
    callback copy-source();
    callback dismissed();
    // Star toggled in the "More" list → add/remove `code` from favourites.
    callback toggle-fav(string);
    // Title-bar drag → Rust moves the OS window by this logical delta.
    callback move-delta(length, length);
    // First use only: say what is sent where, and wait for an answer.
    in-out property <bool> consent-needed: false;
    callback consent(bool);

    property <bool> dd-open: false;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #1c1c1c;
        border-radius: 10px;
        border-width: 1px;
        border-color: #3a3a3a;

        VerticalLayout {
            padding: 14px;
            spacing: 0px;

            // ── Title row (draggable to move the window) ──
            Rectangle {
                height: 22px;
                // Drag layer sits behind the buttons (declared first) so the
                // close button still receives its clicks.
                drag := TouchArea {
                    property <length> lx: 0px;
                    property <length> ly: 0px;
                    property <bool> dragging: false;
                    mouse-cursor: move;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            self.lx = self.mouse-x; self.ly = self.mouse-y; self.dragging = true;
                        }
                        if (ev.kind == PointerEventKind.up) { self.dragging = false; }
                    }
                    moved => {
                        if (self.dragging) {
                            root.move-delta(self.mouse-x - self.lx, self.mouse-y - self.ly);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 20px; height: 20px;
                        border-radius: 5px;
                        background: #ff8a3d;
                        Text {
                            text: "T"; color: #1a0e05;
                            font-size: 12px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                    }
                    Text {
                        text: @tr("Translate");
                        color: #e8e6e2;
                        font-size: 14px; font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.detected-lang == "" ? "" : (root.detected-lang + " →");
                        color: #8a8782;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 6px;
                        background: xta.pressed ? #3a3a3a : (xta.has-hover ? #2a2a2a : transparent);
                        animate background { duration: 80ms; }
                        Glyph {
                            name: "x";
                            paint: xta.has-hover ? #e8e6e2 : #8a8782;
                            size: 14px; weight: 1.7px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        xta := TouchArea { clicked => { root.dismissed(); } }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ── "Target language" header + active label + "More" toggle ──
            HorizontalLayout {
                Text {
                    text: @tr("Target language");
                    color: #5e5b56;
                    font-size: 10px; font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.target-label;
                    color: #ffb066;
                    font-size: 11px; font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                Rectangle {
                    width: 58px; height: 20px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: root.dd-open ? #d96a1f : #3a3a3a;
                    background: dd-ta.pressed ? #2e2e2e : (dd-ta.has-hover || root.dd-open ? #242424 : transparent);
                    animate background { duration: 80ms; }
                    Text {
                        text: @tr("More ▾");
                        color: dd-ta.has-hover || root.dd-open ? #e8e6e2 : #b8b6b1;
                        font-size: 10px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    dd-ta := TouchArea { clicked => { root.dd-open = !root.dd-open; } }
                }
            }
            Rectangle { height: 6px; }

            // ── Quick pills (favourites, edited from the "More" list) ──
            HorizontalLayout {
                spacing: 4px;
                for f in root.favs : TransLangBtn {
                    label: f.short;
                    active: f.code == root.target-lang;
                    clicked => { root.pick-lang(f.code); }
                }
            }

            Rectangle { height: 12px; }

            // ── Source (OCR) ──
            HorizontalLayout {
                Text {
                    text: @tr("Source (OCR)");
                    color: #5e5b56;
                    font-size: 10px; font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 64px; height: 18px;
                    border-radius: 4px;
                    background: cs-ta.pressed ? #2e2e2e : (cs-ta.has-hover ? #242424 : transparent);
                    animate background { duration: 80ms; }
                    border-width: 1px;
                    border-color: #2a2a2a;
                    Text {
                        text: @tr("copy");
                        color: cs-ta.has-hover ? #e8e6e2 : #8a8782;
                        font-size: 10px;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                    cs-ta := TouchArea { clicked => { root.copy-source(); } }
                }
            }
            Rectangle { height: 4px; }
            Rectangle {
                height: 70px;
                border-radius: 7px;
                background: #141414;
                border-width: 1px;
                border-color: #2a2a2a;
                ScrollView {
                    width: 100%; height: 100%;
                    VerticalLayout {
                        padding: 8px;
                        Text {
                            text: root.source-text == "" ? "—" : root.source-text;
                            color: #b8b6b1;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ── Translation (grows with the window) ──
            Text {
                text: @tr("Translation");
                color: #5e5b56;
                font-size: 10px; font-weight: 700;
            }
            Rectangle { height: 4px; }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 7px;
                background: #141414;
                border-width: 1px;
                border-color: root.error-text != "" ? #5a1f1f : #2a2a2a;
                ScrollView {
                    width: 100%; height: 100%;
                    VerticalLayout {
                        padding: 8px;
                        Text {
                            text: root.error-text != ""
                                ? root.error-text
                                : (root.loading ? @tr("translating…") : (root.translated-text == "" ? "" : root.translated-text));
                            color: root.error-text != "" ? #e06363 : (root.loading ? #8a8782 : #e8e6e2);
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Rectangle { height: 12px; }

            // ── Copy translation button ──
            Rectangle {
                height: 34px;
                border-radius: 8px;
                background: copy-ta.pressed ? #e5731f : (copy-ta.has-hover ? #ffa05c : #ff8a3d);
                animate background { duration: 80ms; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    Glyph {
                        name: "copy";
                        paint: #1a0e05;
                        size: 15px; weight: 1.7px;
                    }
                    Text {
                        text: @tr("Copy translation");
                        color: #1a0e05;
                        font-size: 13px; font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                copy-ta := TouchArea { clicked => { root.copy(); } }
            }
        }

        // ── "More" dropdown overlay (full language list) ──
        if root.dd-open : TouchArea {
            // backdrop: click outside closes the dropdown
            width: parent.width; height: parent.height;
            clicked => { root.dd-open = false; }
        }
        if root.dd-open : Rectangle {
            x: 14px;
            y: 92px;
            width: parent.width - 28px;
            height: min(266px, parent.height - 150px);
            background: #202020;
            border-radius: 9px;
            border-width: 1px;
            border-color: #3a3a3a;
            ScrollView {
                width: 100%; height: 100%;
                VerticalLayout {
                    padding: 4px;
                    for l in root.all-langs : Rectangle {
                        height: 28px;
                        border-radius: 5px;
                        background: l.code == root.target-lang
                            ? #2a1d12
                            : (lang-ta.pressed ? #333333 : (lang-ta.has-hover ? #2a2a2a : transparent));
                        animate background { duration: 80ms; }
                        // Row click selects the language (declared first so the
                        // star below sits on top and claims its own clicks).
                        lang-ta := TouchArea {
                            clicked => { root.pick-lang(l.code); root.dd-open = false; }
                        }
                        HorizontalLayout {
                            padding-left: 9px; padding-right: 4px; spacing: 8px;
                            Text {
                                text: l.label;
                                color: l.code == root.target-lang ? #ffb066 : #e8e6e2;
                                font-size: 12px;
                                font-weight: l.code == root.target-lang ? 600 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: l.code;
                                color: #6f6b64;
                                font-size: 10px;
                                font-family: "Consolas";
                                vertical-alignment: center;
                            }
                            // Favourite star — toggles pill membership without
                            // selecting the language or closing the dropdown.
                            Rectangle {
                                width: 28px;
                                Text {
                                    text: l.fav ? "★" : "☆";
                                    color: l.fav ? #ffc83c : (star-ta.has-hover ? #e8e6e2 : #6f6b64);
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                                star-ta := TouchArea {
                                    clicked => { root.toggle-fav(l.code); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Resize grip (bottom-right) ──
        grip := TouchArea {
            width: 22px; height: 22px;
            x: parent.width - self.width;
            y: parent.height - self.height;
            mouse-cursor: nwse-resize;
            property <length> lx: 0px;
            property <length> ly: 0px;
            property <bool> dragging: false;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    self.lx = self.mouse-x; self.ly = self.mouse-y; self.dragging = true;
                }
                if (ev.kind == PointerEventKind.up) { self.dragging = false; }
            }
            moved => {
                if (self.dragging) {
                    root.win-w = max(320px, root.win-w + (self.mouse-x - self.lx));
                    root.win-h = max(320px, root.win-h + (self.mouse-y - self.ly));
                }
            }
            // Corner mark so the grip is discoverable — two stacked nudges that
            // brighten to the brand orange on hover.
            Rectangle {
                x: parent.width - 15px; y: parent.height - 15px;
                width: 10px; height: 10px;
                border-radius: 1px;
                background: transparent;
                border-width: 2px;
                border-color: grip.has-hover ? #ff8a3d : #6a6764;
            }
            Rectangle {
                x: parent.width - 9px; y: parent.height - 9px;
                width: 4px; height: 4px;
                border-radius: 1px;
                background: grip.has-hover ? #ff8a3d : #6a6764;
            }
        }
    }

    // Consent card, over everything else in the popup.
    if root.consent-needed : Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 10px;
        background: #1c1c1cf5;
        TouchArea {
            width: 100%;
            height: 100%;
        }
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            alignment: center;
            Text {
                text: @tr("Send the text to Google?");
                color: #f0eeea;
                font-size: 15px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: @tr("OCR + Translate reads the text in this snip on your computer, then sends that text — not the image — to Google Translate (translate.googleapis.com). Nothing else in Snipdeck sends anything without asking.");
                color: #b8b6b1;
                font-size: 12px;
                wrap: word-wrap;
            }
            Text {
                text: @tr("Asked once; your answer is remembered.");
                color: #7f7b74;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Rectangle {
                    width: 96px;
                    height: 30px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #4a4640;
                    background: no-btn.has-hover ? #2a2826 : transparent;
                    no-btn := TouchArea { clicked => { root.consent(false); } }
                    Text { text: @tr("Cancel"); color: #e8e6e2; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 96px;
                    height: 30px;
                    border-radius: 6px;
                    background: yes-btn.has-hover ? #ffa05c : #ff8a3d;
                    yes-btn := TouchArea { clicked => { root.consent(true); } }
                    Text { text: @tr("Send"); color: #1a0e05; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
