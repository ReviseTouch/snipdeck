[Desktop Entry]
Type=Application
Name=Snipdeck
GenericName=Screen Snipping Deck
Comment=Capture screen regions, keep them on screen, search them later
# Installed builds should point this at the packaged binary. The basename of
# this file is the application id (APP_ID in src/main.rs): the windows' Wayland
# app id and X11 class, and the name the desktop portal files permissions
# under. Rename it and the two no longer meet — see the note below.
Exec=snipdeck
Icon=snipdeck
Terminal=false
Categories=Graphics;
StartupNotify=true
StartupWMClass=com.revisetouch.Snipdeck
Keywords=screenshot;snip;capture;ocr;

# Why the name matters:
#
# Global shortcuts on Wayland go through org.freedesktop.portal.GlobalShortcuts,
# and since xdg-desktop-portal 1.21 that portal refuses a session from a client
# with no application id ("An app id is required"). For an unsandboxed app the
# portal derives that id from the systemd scope the desktop launched it in —
# app-gnome-com.revisetouch.Snipdeck-<pid>.scope — and started any other way,
# from a terminal for one, there is no such scope. Snipdeck then registers the
# id itself (org.freedesktop.host.portal.Registry, xdg-desktop-portal 1.19 and
# later), which the portal accepts only for a reverse-DNS id with a desktop
# entry of that name. On an older portal, launch it from the applications menu.
